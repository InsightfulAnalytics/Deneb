/// Sample data for the KPI Delta Tile template, showcase instance kpi-delta-tile-cost (showcase/data/kpi-delta-tile-cost.csv).
table 'kpi-delta-tile-cost'
	lineageTag: 2fb915f0-f876-59ba-a1b5-aed0f1b5241f

	/// The KPI, for example sales this month.
	measure 'Value (kpi-delta-tile-cost)' = SUM ( 'kpi-delta-tile-cost'[Value] )
		lineageTag: f5487e97-17e0-5dd8-b216-728e43867b61

	/// What Value is compared with: prior year, prior period, budget or target. Name it in comparisonLabel.
	measure 'Benchmark (kpi-delta-tile-cost)' = SUM ( 'kpi-delta-tile-cost'[Benchmark] )
		lineageTag: 5ec36c94-dacc-5930-becc-d93b86a7f895

	column Value
		dataType: double
		isHidden
		lineageTag: ac386a99-ac78-5976-9d4a-01c62cba49ce
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = User

	column Benchmark
		dataType: double
		isHidden
		lineageTag: b3e751cb-0a73-5cc4-be11-53dd3e29ff4f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Benchmark]

		annotation SummarizationSetBy = User

	partition 'kpi-delta-tile-cost' = calculated
		mode: import
		source =
				DATATABLE (
				    "Value", DOUBLE,
				    "Benchmark", DOUBLE,
				    {
				        { 2614900, 2448300 }
				    }
				)
