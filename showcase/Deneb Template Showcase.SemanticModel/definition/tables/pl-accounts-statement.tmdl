/// Sample data for the P&L Accounts Statement template, showcase instance pl-accounts-statement (templates/financial/pl-accounts-statement/sample-data.csv).
table 'pl-accounts-statement'
	lineageTag: dfbe47fa-bf2d-5969-8b7e-71e746f42056

	/// Actual amount for the current period. Costs are negative.
	measure 'Actual (pl-accounts-statement)' = SUM ( 'pl-accounts-statement'[Actual] )
		lineageTag: 335d95ad-0af5-5914-aff4-a756bf099b6f

	/// Budget amount for the current period. Costs are negative.
	measure 'Budget (pl-accounts-statement)' = SUM ( 'pl-accounts-statement'[Budget] )
		lineageTag: 58350b14-8e40-5fcf-b326-f91b4ad0b926

	/// Last year's actual for the same period. Costs are negative.
	measure 'LY (pl-accounts-statement)' = SUM ( 'pl-accounts-statement'[LY] )
		lineageTag: 68994254-188d-5b8e-a212-c83aa1351d4f

	/// Actual amount, year to date. Costs are negative.
	measure 'YTD Actual (pl-accounts-statement)' = SUM ( 'pl-accounts-statement'[YTD Actual] )
		lineageTag: 70ef07ff-cf64-5d47-9d28-cce7ea12b44a

	/// Budget amount, year to date. Costs are negative.
	measure 'YTD Budget (pl-accounts-statement)' = SUM ( 'pl-accounts-statement'[YTD Budget] )
		lineageTag: 65d05a10-a468-56dd-808b-6a97530e6ddd

	/// Last year's actual, year to date. Costs are negative.
	measure 'YTD LY (pl-accounts-statement)' = SUM ( 'pl-accounts-statement'[YTD LY] )
		lineageTag: 3fe4aab3-c548-5137-a1ee-9901d7b1f09e

	/// Statement line label, one row per line. A leading indent is stripped; LineClass sets the indent.
	column Line
		dataType: string
		lineageTag: 1daf1447-b504-5753-9231-7bbea37b44ba
		summarizeBy: none
		isNameInferred
		sourceColumn: [Line]

		annotation SummarizationSetBy = User

	/// Sort key for the lines, ascending. Any increasing numbers work.
	column LineKey
		dataType: double
		lineageTag: 95821e6c-868b-5e5a-b610-bc625f319d6f
		summarizeBy: none
		isNameInferred
		sourceColumn: [LineKey]

		annotation SummarizationSetBy = User

	/// Detail for an account line. Any other value (Subtotal, Total) is drawn bold with a rule above.
	column LineClass
		dataType: string
		lineageTag: e1d95157-f936-5397-a567-408e3b46b34d
		summarizeBy: none
		isNameInferred
		sourceColumn: [LineClass]

		annotation SummarizationSetBy = User

	column Actual
		dataType: double
		isHidden
		lineageTag: 9a4a6b1f-e3ac-5981-b4f5-f4ca948ced3c
		summarizeBy: none
		isNameInferred
		sourceColumn: [Actual]

		annotation SummarizationSetBy = User

	column Budget
		dataType: double
		isHidden
		lineageTag: 85e03c64-991d-57ea-b5fd-ffb6b427b026
		summarizeBy: none
		isNameInferred
		sourceColumn: [Budget]

		annotation SummarizationSetBy = User

	column LY
		dataType: double
		isHidden
		lineageTag: 4199ef47-680c-5311-9e90-72d506411ed2
		summarizeBy: none
		isNameInferred
		sourceColumn: [LY]

		annotation SummarizationSetBy = User

	column 'YTD Actual'
		dataType: double
		isHidden
		lineageTag: 0cf70315-e128-5e7c-862b-79267839f947
		summarizeBy: none
		isNameInferred
		sourceColumn: [YTD Actual]

		annotation SummarizationSetBy = User

	column 'YTD Budget'
		dataType: double
		isHidden
		lineageTag: d0481c53-5812-5165-ac94-e970662c4c78
		summarizeBy: none
		isNameInferred
		sourceColumn: [YTD Budget]

		annotation SummarizationSetBy = User

	column 'YTD LY'
		dataType: double
		isHidden
		lineageTag: 75cbabc4-4b08-5a98-ab18-864590326bd6
		summarizeBy: none
		isNameInferred
		sourceColumn: [YTD LY]

		annotation SummarizationSetBy = User

