/// Sample data for the KPI Line Card template, showcase instance dash-otd (showcase/data/dash-otd.csv).
table 'dash-otd'
	lineageTag: 46b7daaa-d533-5fee-aa10-25750e4ef1dd

	/// The month's value, for example net revenue or an on-time delivery rate.
	measure 'Value (dash-otd)' = SUM ( 'dash-otd'[Value] )
		lineageTag: c0bda5ca-50ad-5a8f-966a-b6ec13f14556

	/// The month's target for Value.
	measure 'Target (dash-otd)' = SUM ( 'dash-otd'[Target] )
		lineageTag: 685007ef-c183-51a5-93f8-bb805144f23d

	/// 1 on the month the card reports on, else 0. With no 1 in the data the latest month is used.
	measure 'Is Reporting Month (dash-otd)' = SUM ( 'dash-otd'[Is Reporting Month] )
		lineageTag: 671911c9-c380-5e77-90c2-c3a9f639f8aa

	/// Month end date, one row per month. The line draws every month it receives.
	column Month
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 7e00b2de-8a32-58d3-9494-23c696a90fae
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column Value
		dataType: double
		isHidden
		lineageTag: 08cf1a6f-3573-59ae-af56-73e546eb01e3
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = User

	column Target
		dataType: double
		isHidden
		lineageTag: ab2ca010-ead9-56e2-8ed7-b52ea89fe133
		summarizeBy: none
		isNameInferred
		sourceColumn: [Target]

		annotation SummarizationSetBy = User

	column 'Is Reporting Month'
		dataType: double
		isHidden
		lineageTag: e2b3c45f-1f62-57f2-9e22-bf9e9ca5a400
		summarizeBy: none
		isNameInferred
		sourceColumn: [Is Reporting Month]

		annotation SummarizationSetBy = User

	partition 'dash-otd' = calculated
		mode: import
		source =
				DATATABLE (
				    "Month", DATETIME,
				    "Value", DOUBLE,
				    "Target", DOUBLE,
				    "Is Reporting Month", DOUBLE,
				    {
				        { "2015-01-31", 0.91, 0.95, 0 },
				        { "2015-02-28", 0.983, 0.95, 0 },
				        { "2015-03-31", 0.917, 0.95, 0 },
				        { "2015-04-30", 0.986, 0.95, 1 }
				    }
				)
