/// Sample data for the KPI Gap Sparkline Card template, showcase instance kpi-gap-sparkline-card (templates/kpi/kpi-gap-sparkline-card/sample-data.csv).
table 'kpi-gap-sparkline-card'
	lineageTag: 6fbb5336-31a6-5b49-af30-4c412819fdfc

	/// The value for the day, for example orders in euros.
	measure 'Actual (kpi-gap-sparkline-card)' = SUM ( 'kpi-gap-sparkline-card'[Actual] )
		lineageTag: 61b9d06e-d0f9-5ab1-a549-0125a9939107

	/// The same day last year, or a daily target.
	measure 'Comparison (kpi-gap-sparkline-card)' = SUM ( 'kpi-gap-sparkline-card'[Comparison] )
		lineageTag: ab8e469f-1f20-5a02-98e6-1aae8bcd9780

	/// The day. One row per day; the latest day with an Actual value is today.
	column Date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 8813020e-39e0-5f1c-ab4c-0ad9300b6b8a
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column Actual
		dataType: double
		isHidden
		lineageTag: 9fecb594-5ec8-5c3c-a4ef-787c84b88d47
		summarizeBy: none
		isNameInferred
		sourceColumn: [Actual]

		annotation SummarizationSetBy = User

	column Comparison
		dataType: double
		isHidden
		lineageTag: abef3cde-24c5-56ca-a64b-5efb0e57c4d2
		summarizeBy: none
		isNameInferred
		sourceColumn: [Comparison]

		annotation SummarizationSetBy = User

