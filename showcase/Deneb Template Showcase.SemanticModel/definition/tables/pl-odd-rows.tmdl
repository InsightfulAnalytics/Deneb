				        { "Gross Profit", "YTD LY", 24127658, 27, 2384 },
				        { "Total Operating Expenses", "YTD LY", -18990869, 27, 2384 },
				        { "Net Profit", "YTD LY", 5136789, 27, 2384 },
				        { "Total Income", "YTD Budget", 62917172, 28, 2500 },
				        { "Total Cost of Sales", "YTD Budget", -38405635, 28, 2500 },
