/// Sample data for the Monthly P&L Grid template, showcase instance pl-monthly-grid (templates/financial/pl-monthly-grid/sample-data.csv).
table 'pl-monthly-grid'
	lineageTag: 8e26773f-5057-570e-90af-227ca92d1c4b

	/// Months from the current month: 0 this month, -1 last month. Use the minimum over the month.
	measure 'Month Offset (pl-monthly-grid)' = SUM ( 'pl-monthly-grid'[Month Offset] )
		lineageTag: 82e5a8a5-16f2-53bf-9f46-a290051d816f

	/// 1 for a month to highlight, else 0. A measure that always returns 0 turns highlighting off.
	measure 'Month Selected (pl-monthly-grid)' = SUM ( 'pl-monthly-grid'[Month Selected] )
		lineageTag: c4344657-c340-5249-9a7b-230b1013c272

	/// Total income, actual.
	measure 'Income Act (pl-monthly-grid)' = SUM ( 'pl-monthly-grid'[Income Act] )
		lineageTag: c68a9d98-1258-5567-9613-047b08d32ae7

	/// Total income, last year.
	measure 'Income LY (pl-monthly-grid)' = SUM ( 'pl-monthly-grid'[Income LY] )
		lineageTag: 471fd190-e758-5b61-b539-97abc1ded6d9

	/// Total cost of sales, actual, as a negative number.
	measure 'COGS Act (pl-monthly-grid)' = SUM ( 'pl-monthly-grid'[COGS Act] )
		lineageTag: 05740843-034b-510a-845d-01a04bc22835

	/// Total cost of sales, last year, as a negative number.
	measure 'COGS LY (pl-monthly-grid)' = SUM ( 'pl-monthly-grid'[COGS LY] )
		lineageTag: f077c034-e1a3-5cdc-a876-ae47d37764e2

	/// Gross profit, actual.
	measure 'GP Act (pl-monthly-grid)' = SUM ( 'pl-monthly-grid'[GP Act] )
		lineageTag: d8e47603-c14a-56cc-8608-b6a39b436c9f

	/// Gross profit, last year.
	measure 'GP LY (pl-monthly-grid)' = SUM ( 'pl-monthly-grid'[GP LY] )
		lineageTag: 7eea5a56-59c7-53bd-8d49-a144a848c51a

	/// Total operating expenses, actual, as a negative number.
	measure 'Opex Act (pl-monthly-grid)' = SUM ( 'pl-monthly-grid'[Opex Act] )
		lineageTag: 4e222888-8a4c-5d30-af8d-afddb49403df

	/// Total operating expenses, last year, as a negative number.
	measure 'Opex LY (pl-monthly-grid)' = SUM ( 'pl-monthly-grid'[Opex LY] )
		lineageTag: 19952941-660a-5631-97f7-c1cb7c000848

	/// Net profit, actual.
	measure 'NP Act (pl-monthly-grid)' = SUM ( 'pl-monthly-grid'[NP Act] )
		lineageTag: 46189001-1d5c-5e04-80a3-07b460b8cf0f

	/// Net profit, last year.
	measure 'NP LY (pl-monthly-grid)' = SUM ( 'pl-monthly-grid'[NP LY] )
		lineageTag: e2ed42ec-c8fc-503a-9b44-48cd157c49a8

	/// Calendar year. One row per year and month.
	column Year
		dataType: double
		lineageTag: 8b6f5c62-d1c9-51c0-ade3-fae88fe4642f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = User

	/// Month number, 1 to 12.
	column Month
		dataType: double
		lineageTag: 1b8a6606-e5fc-5fbd-bb55-3771fbfdf212
