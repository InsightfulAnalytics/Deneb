/// Sample data for the Ring Progress Card template, showcase instance kpi-ring-progress-card-status (showcase/data/kpi-ring-progress-card-status.csv).
table 'kpi-ring-progress-card-status'
	lineageTag: 09b3b372-4c28-5ff2-8491-c9761c4e9f45

	/// Progress so far.
	measure 'Value (kpi-ring-progress-card-status)' = SUM ( 'kpi-ring-progress-card-status'[Value] )
		lineageTag: 06cf3b96-1dd7-5212-b942-bc76e632f218

	/// The target the ring fills to.
	measure 'Target (kpi-ring-progress-card-status)' = SUM ( 'kpi-ring-progress-card-status'[Target] )
		lineageTag: 17ee49ef-7c3c-56eb-aa98-27e551f8c3f0

	column Value
		dataType: double
		isHidden
		lineageTag: bd8ae6da-a343-58b4-9bf0-2f048eb36f9f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = User

	column Target
		dataType: double
		isHidden
		lineageTag: 901e3eab-04c8-50bb-97fd-d9cb414eb191
		summarizeBy: none
		isNameInferred
		sourceColumn: [Target]

		annotation SummarizationSetBy = User

	partition 'kpi-ring-progress-card-status' = calculated
		mode: import
		source =
				DATATABLE (
				    "Value", DOUBLE,
				    "Target", DOUBLE,
				    {
				        { 4380000, 4000000 }
				    }
				)
