/// Sample data for the KPI Small Multiples template, showcase instance kpi-small-multiples (templates/kpi/kpi-small-multiples/sample-data.csv).
table 'kpi-small-multiples'
	lineageTag: 7f1e8d7c-08ef-546f-8731-d37a12935656

	/// The KPI per category and date.
	measure 'Value (kpi-small-multiples)' = SUM ( 'kpi-small-multiples'[Value] )
		lineageTag: 5b37045a-1c3e-534a-aa9e-2dfb3a2c8f4c

	/// One panel each, for example Region or Product.
	column Category
		dataType: string
		lineageTag: 7c9ffbf1-55f1-5621-892d-f0bfeb4d5b06
		summarizeBy: none
		isNameInferred
		sourceColumn: [Category]

		annotation SummarizationSetBy = User

	/// The sparkline axis: a day, a week or a month.
	column Date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: edd376be-25c1-5288-9f3b-4c547ae7c3c0
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column Value
		dataType: double
		isHidden
		lineageTag: 6b9949e5-92e9-5f37-8d80-a7281e5a0e27
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = User

