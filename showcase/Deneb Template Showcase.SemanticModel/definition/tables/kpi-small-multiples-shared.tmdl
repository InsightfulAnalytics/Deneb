/// Sample data for the KPI Small Multiples template, showcase instance kpi-small-multiples-shared (showcase/data/kpi-small-multiples-shared.csv).
table 'kpi-small-multiples-shared'
	lineageTag: cb2651d2-b243-57d0-83b1-0c677be9a506

	/// The KPI per category and date.
	measure 'Value (kpi-small-multiples-shared)' = SUM ( 'kpi-small-multiples-shared'[Value] )
		lineageTag: 29ac3620-850c-501a-855f-db3ae1844c5b

	/// One panel each, for example Region or Product.
	column Category
		dataType: string
		lineageTag: d59da2b0-a3f3-5334-a4a2-cfa61718ea7e
		summarizeBy: none
		isNameInferred
		sourceColumn: [Category]

		annotation SummarizationSetBy = User

	/// The sparkline axis: a day, a week or a month.
	column Date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 2aee76dc-9a89-5edc-9740-4dd1aed9972e
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

