/// Sample data for the Run-rate Projection Card template, showcase instance kpi-run-rate-card-cost (showcase/data/kpi-run-rate-card-cost.csv).
table 'kpi-run-rate-card-cost'
	lineageTag: e72aa2a5-2789-5e1b-9691-379f05e3db59

	/// The day value. Blank after the last day with data.
	measure 'Value (kpi-run-rate-card-cost)' = SUM ( 'kpi-run-rate-card-cost'[Value] )
		lineageTag: 89bca1b0-cce2-5900-8fca-b727e7bf0561

	/// The day target (summed), or the whole period target on every row with targetPerRow false.
	measure 'Target (kpi-run-rate-card-cost)' = SUM ( 'kpi-run-rate-card-cost'[Target] )
		lineageTag: e92e8d4f-ff8c-5b60-b96b-5795c75da59c

	/// One row per day of the period. Days still to come can carry a Target and a blank Value.
	column Date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: cd1551e0-d3fa-595c-8fbd-d30ed01bee6c
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column Value
		dataType: double
		isHidden
		lineageTag: 7e334507-931b-5fc2-9c1b-0021390c3559
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = User

	column Target
		dataType: double
		isHidden
		lineageTag: e2ab5a9c-b92e-58d7-86e7-bb97886bb530
		summarizeBy: none
		isNameInferred
		sourceColumn: [Target]

		annotation SummarizationSetBy = User

	partition 'kpi-run-rate-card-cost' = calculated
		mode: import
		source =
