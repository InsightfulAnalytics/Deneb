/// Sample data for the KPI Gap Sparkline Card template, showcase instance kpi-gap-sparkline-card-bad (showcase/data/kpi-gap-sparkline-card-bad.csv).
table 'kpi-gap-sparkline-card-bad'
	lineageTag: 00e87466-393f-5f2c-97c1-ea857c01f1fc

	/// The value for the day, for example orders in euros.
	measure 'Actual (kpi-gap-sparkline-card-bad)' = SUM ( 'kpi-gap-sparkline-card-bad'[Actual] )
		lineageTag: 7fb47d2b-4886-5e7b-a081-af7c2323135c

	/// The same day last year, or a daily target.
	measure 'Comparison (kpi-gap-sparkline-card-bad)' = SUM ( 'kpi-gap-sparkline-card-bad'[Comparison] )
		lineageTag: 23603c66-735f-5b06-8dd4-a4a662211536

	/// The day. One row per day; the latest day with an Actual value is today.
	column Date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 0db102fb-e47e-5825-9caa-db4b28c8b86a
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column Actual
		dataType: double
		isHidden
		lineageTag: ad92cbbd-9613-58f2-b9ba-140d7228bb49
		summarizeBy: none
		isNameInferred
		sourceColumn: [Actual]

		annotation SummarizationSetBy = User

	column Comparison
		dataType: double
		isHidden
		lineageTag: 8187e86d-b342-5665-b881-b35a5d96d23e
		summarizeBy: none
		isNameInferred
		sourceColumn: [Comparison]

		annotation SummarizationSetBy = User

