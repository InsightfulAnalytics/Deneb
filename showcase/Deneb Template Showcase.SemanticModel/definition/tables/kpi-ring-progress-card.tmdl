/// Sample data for the Ring Progress Card template, showcase instance kpi-ring-progress-card (templates/kpi/kpi-ring-progress-card/sample-data.csv).
table 'kpi-ring-progress-card'
	lineageTag: 285a8aa3-df7e-5bf3-b4d7-16ad8381bd69

	/// Progress so far.
	measure 'Value (kpi-ring-progress-card)' = SUM ( 'kpi-ring-progress-card'[Value] )
		lineageTag: 017142f9-d767-52ac-8805-41be4e14a639

	/// The target the ring fills to.
	measure 'Target (kpi-ring-progress-card)' = SUM ( 'kpi-ring-progress-card'[Target] )
		lineageTag: 0d3aa0a1-408a-53a9-b668-96597d63bfbc

	column Value
		dataType: double
		isHidden
		lineageTag: 50ccb890-09d7-5ab6-808f-14beef85e65f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = User

	column Target
		dataType: double
		isHidden
		lineageTag: 0de7a6c4-ecf8-58dc-90d7-3e5d50c62d1f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Target]

		annotation SummarizationSetBy = User

	partition 'kpi-ring-progress-card' = calculated
		mode: import
		source =
				DATATABLE (
				    "Value", DOUBLE,
				    "Target", DOUBLE,
				    {
				        { 3420000, 4000000 }
				    }
				)
