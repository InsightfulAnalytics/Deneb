/// Sample data for the KPI Progress Card template, showcase instance kpi-progress-card-no-pace (showcase/data/kpi-progress-card-no-pace.csv).
table 'kpi-progress-card-no-pace'
	lineageTag: 2a986f0c-4bf3-5f15-a185-cb853a2e431d

	/// Progress so far, for example sales month to date.
	measure 'Value (kpi-progress-card-no-pace)' = SUM ( 'kpi-progress-card-no-pace'[Value] )
		lineageTag: 0d420235-2f51-58d0-9494-a2f3c670ce91

	/// The target for the whole period.
	measure 'Target (kpi-progress-card-no-pace)' = SUM ( 'kpi-progress-card-no-pace'[Target] )
		lineageTag: bf02fb7b-444f-5217-be07-c33c5d5d5bb9

	/// Share of the period gone, 0 to 1, for the pace marker. A measure returning BLANK() hides the marker.
	measure 'Percent Elapsed (kpi-progress-card-no-pace)' = SUM ( 'kpi-progress-card-no-pace'[Percent Elapsed] )
		lineageTag: 5a7cb4a4-f2b1-51aa-a5dd-029b9671ba6e

	column Value
		dataType: double
		isHidden
		lineageTag: 345cecc1-e85a-51cf-bd67-0a778fa62377
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = User

	column Target
		dataType: double
		isHidden
		lineageTag: 92082c2d-e0d5-5704-81c1-fa56cc1033fb
		summarizeBy: none
		isNameInferred
		sourceColumn: [Target]

		annotation SummarizationSetBy = User

	column 'Percent Elapsed'
		dataType: double
		isHidden
		lineageTag: cc663e0f-f108-5eb3-8b0f-753247273416
		summarizeBy: none
		isNameInferred
		sourceColumn: [Percent Elapsed]

		annotation SummarizationSetBy = User

	partition 'kpi-progress-card-no-pace' = calculated
		mode: import
		source =
				DATATABLE (
				    "Value", DOUBLE,
				    "Target", DOUBLE,
				    "Percent Elapsed", DOUBLE,
				    {
				        { 4380000, 4000000, BLANK () }
				    }
				)
