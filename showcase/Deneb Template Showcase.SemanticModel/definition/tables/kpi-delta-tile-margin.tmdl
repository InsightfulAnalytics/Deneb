/// Sample data for the KPI Delta Tile template, showcase instance kpi-delta-tile-margin (showcase/data/kpi-delta-tile-margin.csv).
table 'kpi-delta-tile-margin'
	lineageTag: 633b23ea-2f26-56ee-a3d8-367d440039c2

	/// The KPI, for example sales this month.
	measure 'Value (kpi-delta-tile-margin)' = SUM ( 'kpi-delta-tile-margin'[Value] )
		lineageTag: 17f6dbcf-4611-561f-8860-9c41530268fd

	/// What Value is compared with: prior year, prior period, budget or target. Name it in comparisonLabel.
	measure 'Benchmark (kpi-delta-tile-margin)' = SUM ( 'kpi-delta-tile-margin'[Benchmark] )
		lineageTag: 66a6587b-2168-5886-ab67-0e4245ba961f

	column Value
		dataType: double
		isHidden
		lineageTag: fd9aa1a5-2077-5c35-9c93-b93a17269016
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = User

	column Benchmark
		dataType: double
		isHidden
		lineageTag: 4bfcb5d8-6e00-5812-868d-aaf572d504f2
		summarizeBy: none
		isNameInferred
		sourceColumn: [Benchmark]

		annotation SummarizationSetBy = User

	partition 'kpi-delta-tile-margin' = calculated
		mode: import
		source =
				DATATABLE (
				    "Value", DOUBLE,
				    "Benchmark", DOUBLE,
				    {
				        { 0.382, 0.401 }
				    }
				)
