/// Sample data for the KPI Progress Card template, showcase instance kpi-progress-card (templates/kpi/kpi-progress-card/sample-data.csv).
table 'kpi-progress-card'
	lineageTag: b1e216e1-35f8-5828-b89c-fe5612db5e0a

	/// Progress so far, for example sales month to date.
	measure 'Value (kpi-progress-card)' = SUM ( 'kpi-progress-card'[Value] )
		lineageTag: 8aa1e9f0-b312-5c1f-bbab-f679013cc465

	/// The target for the whole period.
	measure 'Target (kpi-progress-card)' = SUM ( 'kpi-progress-card'[Target] )
		lineageTag: 768829e6-4c69-5f43-9aa1-e3330ec05d9e

	/// Share of the period gone, 0 to 1, for the pace marker. A measure returning BLANK() hides the marker.
	measure 'Percent Elapsed (kpi-progress-card)' = SUM ( 'kpi-progress-card'[Percent Elapsed] )
		lineageTag: 728486e5-cc9d-51b3-81f3-61f6141f852b

	column Value
		dataType: double
		isHidden
		lineageTag: f9be0952-e51c-5a33-8262-b58459b975b7
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = User

	column Target
		dataType: double
		isHidden
		lineageTag: 4c677b31-374b-591b-a321-43e5f30ee932
		summarizeBy: none
		isNameInferred
		sourceColumn: [Target]

		annotation SummarizationSetBy = User

	column 'Percent Elapsed'
		dataType: double
		isHidden
		lineageTag: 2465b594-36f6-5901-a0ec-44cbc066dca6
		summarizeBy: none
		isNameInferred
		sourceColumn: [Percent Elapsed]

		annotation SummarizationSetBy = User

	partition 'kpi-progress-card' = calculated
		mode: import
		source =
				DATATABLE (
				    "Value", DOUBLE,
				    "Target", DOUBLE,
				    "Percent Elapsed", DOUBLE,
				    {
				        { 3184500, 4000000, 0.71 }
				    }
				)
