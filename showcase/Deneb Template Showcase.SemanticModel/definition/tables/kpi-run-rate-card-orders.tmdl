/// Sample data for the Run-rate Projection Card template, showcase instance kpi-run-rate-card-orders (showcase/data/kpi-run-rate-card-orders.csv).
table 'kpi-run-rate-card-orders'
	lineageTag: ec77a6b4-e09f-5b74-99b1-8288d56f901d

	/// The day value. Blank after the last day with data.
	measure 'Value (kpi-run-rate-card-orders)' = SUM ( 'kpi-run-rate-card-orders'[Value] )
		lineageTag: 0629fb3e-d21d-57d8-945f-0b7ac9d36877

	/// The day target (summed), or the whole period target on every row with targetPerRow false.
	measure 'Target (kpi-run-rate-card-orders)' = SUM ( 'kpi-run-rate-card-orders'[Target] )
		lineageTag: 37ffd53e-7490-5781-9ff7-97d78b79c84c

	/// One row per day of the period. Days still to come can carry a Target and a blank Value.
	column Date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 477efb12-fb71-5d83-ac68-1f89f32be847
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column Value
		dataType: double
		isHidden
		lineageTag: 2adbe62f-7989-5e05-b379-ff08e2c62e6e
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = User

	column Target
		dataType: double
		isHidden
		lineageTag: 4123885e-3d57-5018-b915-69fc184c0655
		summarizeBy: none
		isNameInferred
		sourceColumn: [Target]

		annotation SummarizationSetBy = User

