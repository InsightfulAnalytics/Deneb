    },
    {
      "calculate": "datum.topY + 12 * datum.pu",
      "as": "chY"
    },
    {
      "calculate": "datum.px0 + datum.ip",
      "as": "sx0"
    },
    {
      "calculate": "datum.px0 + datum.pw - datum.ip",
      "as": "sx1"
    },
    {
      "calculate": "datum.chY + 5 * datum.pu",
      "as": "sy0"
    },
    {
      "calculate": "datum.py0 + datum.ph - datum.ip",
      "as": "sy1"
    },
    {
      "calculate": "sharedScale ? datum.gMin : datum.vMin",
      "as": "lo"
    },
    {
      "calculate": "sharedScale ? datum.gMax : datum.vMax",
      "as": "hi"
    },
    {
      "calculate": "datum.tMax > datum.tMin ? datum.sx0 + (datum.t - datum.tMin) / (datum.tMax - datum.tMin) * (datum.sx1 - datum.sx0) : (datum.sx0 + datum.sx1) / 2",
      "as": "sx"
    },
    {
      "calculate": "datum.hi > datum.lo ? datum.sy1 - (datum.v - datum.lo) / (datum.hi - datum.lo) * (datum.sy1 - datum.sy0) : (datum.sy0 + datum.sy1) / 2",
      "as": "sy"
    },
    {
      "calculate": "(!isValid(datum.latest) || !isFinite(datum.latest) ? noDataText : valueFormat !== 'auto' ? format(datum.latest, valueFormat) : (datum.latest < 0 ? '−' : '') + prefix + format(abs(datum.latest) / (abs(datum.latest) >= 999.5e6 ? 1e9 : abs(datum.latest) >= 999.5e3 ? 1e6 : abs(datum.latest) >= 999.5 ? 1e3 : 1), abs(datum.latest) / (abs(datum.latest) >= 999.5e6 ? 1e9 : abs(datum.latest) >= 999.5e3 ? 1e6 : abs(datum.latest) >= 999.5 ? 1e3 : 1) < 10 ? ((abs(datum.latest) >= 999.5e6 ? 1e9 : abs(datum.latest) >= 999.5e3 ? 1e6 : abs(datum.latest) >= 999.5 ? 1e3 : 1) > 1 ? '.1f' : '.2~f') : ',.0f') + (abs(datum.latest) >= 999.5e6 ? 'bn' : abs(datum.latest) >= 999.5e3 ? 'M' : abs(datum.latest) >= 999.5 ? 'K' : ''))",
      "as": "valueText"
    },
    {
      "calculate": "(!isValid(datum.ch) ? '' : datum.ch > 0 ? arrowUp : datum.ch < 0 ? arrowDown : arrowFlat) + ' ' + (!isValid(datum.ch) || !isFinite(datum.ch) ? noDataText : format(datum.ch, pctFormat))",
      "as": "chText"
    },
    {
      "calculate": "(datum.g > 0 ? colorGood : datum.g < 0 ? colorBad : colorNeutral)",
      "as": "chColor"
    },
    {
      "calculate": "datum.px0 + datum.ip",
      "as": "nameX"
    },
    {
      "calculate": "datum.topY",
      "as": "nameY"
    },
    {
      "calculate": "10.5 * datum.pu",
