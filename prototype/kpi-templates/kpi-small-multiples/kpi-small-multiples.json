    },
    {
      "calculate": "datum.topY",
      "as": "valueY"
    },
    {
      "calculate": "15 * datum.pu",
      "as": "valueSize"
    },
    {
      "calculate": "10 * datum.pu",
      "as": "chSize"
    },
    {
      "calculate": "max(20, datum.pw - 2 * datum.ip - 0.6 * datum.valueSize * length(datum.valueText) - 6 * datum.pu)",
