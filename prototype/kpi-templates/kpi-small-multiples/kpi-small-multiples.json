          "field": "firstRow",
          "as": "catRow"
        }
      ],
      "groupby": [
        "cat"
      ]
    },
    {
      "calculate": "datum.t === datum.lastT ? datum.v : null",
      "as": "latestPart"
    },
    {
      "calculate": "datum.t === datum.lastT ? datum.prevV : null",
      "as": "prevPart"
    },
    {
      "calculate": "datum.k === 1 ? datum.v : null",
      "as": "firstPart"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "latestPart",
          "as": "latest"
        },
        {
          "op": "max",
          "field": "prevPart",
          "as": "prev"
        },
        {
          "op": "max",
          "field": "firstPart",
          "as": "first"
        }
      ],
      "groupby": [
        "cat"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "v",
          "as": "gMin"
        },
        {
          "op": "max",
          "field": "v",
          "as": "gMax"
        },
        {
          "op": "min",
          "field": "t",
          "as": "tMin"
        },
        {
          "op": "max",
          "field": "t",
          "as": "tMax"
        },
        {
          "op": "distinct",
          "field": "cat",
          "as": "nCats"
        }
      ]
    },
    {
      "calculate": "changeVs === 'first' ? datum.first : datum.prev",
      "as": "base"
    },
    {
      "calculate": "isValid(datum.base) && datum.base !== 0 ? (datum.latest - datum.base) / abs(datum.base) : null",
      "as": "ch"
    },
    {
      "calculate": "isValid(datum.ch) ? (higherIsBetter ? 1 : -1) * datum.ch : 0",
      "as": "g"
    },
    {
      "calculate": "sortBy === 'value' ? -datum.latest : sortBy === 'change' ? (isValid(datum.ch) ? -datum.g : 1e300) : sortBy === 'name' ? 0 : datum.catRow",
      "as": "sortKey"
    },
    {
      "window": [
        {
          "op": "dense_rank",
          "as": "panel"
        }
      ],
      "sort": [
        {
          "field": "sortKey",
          "order": "ascending"
        },
        {
          "field": "cat",
          "order": "ascending"
        }
      ]
    },
    {
      "calculate": "columns > 0 ? min(columns, datum.nCats) : clamp(floor(width / minPanelWidth), 1, datum.nCats)",
      "as": "cols"
    },
    {
      "calculate": "min(ceil(datum.nCats / datum.cols), max(1, floor((height - headerH) / minPanelHeight)))",
      "as": "rowsUsed"
    },
    {
      "filter": "datum.panel <= datum.cols * datum.rowsUsed"
    },
    {
      "calculate": "width / datum.cols",
      "as": "pw"
    },
    {
      "calculate": "(height - headerH) / datum.rowsUsed",
      "as": "ph"
    },
    {
      "calculate": "((datum.panel - 1) % datum.cols) * datum.pw",
      "as": "px0"
    },
    {
      "calculate": "headerH + floor((datum.panel - 1) / datum.cols) * datum.ph",
      "as": "py0"
    },
    {
      "calculate": "clamp(min(datum.pw / 150, datum.ph / 72), 0.6, 1.8)",
