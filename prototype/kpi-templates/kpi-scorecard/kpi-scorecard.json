    "information": {
      "name": "KPI Scorecard",
      "description": "Several KPIs in one visual, one row each: name, actual, target, the variance and a mini bar or status dot. A Format column lets a currency, a rate and a count share the table; rows that do not fit become a \"+n more\" line.",
      "author": "Timothy Osborn",
      "uuid": "ebf89cb6-e8b8-44d1-8ff9-de84a3085787",
      "generated": "2026-10-18T00:00:00.000Z"
    },
    "dataset": [
      {
        "key": "__0__",
        "name": "KPI Name",
        "description": "One row per KPI, for example from a disconnected KPI table. Any category works too: a region or a product.",
