  "transform": [
    {
      "window": [
        {
          "op": "row_number",
          "as": "rowIn"
        }
      ]
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "__1__",
          "as": "vSum"
        },
        {
          "op": "valid",
          "field": "__1__",
          "as": "vN"
        },
        {
          "op": "sum",
          "field": "__2__",
          "as": "tgSum"
        },
