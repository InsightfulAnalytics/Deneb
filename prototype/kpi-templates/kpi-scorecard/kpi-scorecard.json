          "scale": null
        },
        "x2": {
          "field": "sx1"
        },
        "y": {
          "field": "barY0",
          "type": "quantitative",
          "scale": null
        },
        "y2": {
          "field": "barY1"
        }
      }
    },
    {
      "description": "Mini bar: Value against Target, to 125%",
      "transform": [
        {
          "filter": "statusStyle === 'bar' && datum.rank <= datum.shown && datum.fillX > datum.sx0"
        }
      ],
      "mark": {
        "type": "rect"
      },
      "encoding": {
        "x": {
          "field": "sx0",
          "type": "quantitative",
          "scale": null
        },
        "x2": {
          "field": "fillX"
        },
        "y": {
          "field": "barY0",
          "type": "quantitative",
          "scale": null
        },
        "y2": {
          "field": "barY1"
        },
        "color": {
          "field": "statusColor",
          "type": "nominal",
          "scale": null
        },
        "tooltip": [
          {
            "field": "name",
            "type": "nominal",
            "title": "KPI"
          },
          {
            "field": "valueText",
            "type": "nominal",
            "title": "Actual"
          },
          {
            "field": "targetText",
            "type": "nominal",
            "title": "Target"
          },
          {
            "field": "deltaText",
            "type": "nominal",
            "title": "Variance"
          }
        ]
      }
    },
    {
      "description": "Mini bar: target tick at 100%",
      "transform": [
        {
          "filter": "statusStyle === 'bar' && datum.rank <= datum.shown"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": {
          "expr": "valueColor"
        },
        "strokeWidth": {
          "expr": "1.5 * unit"
        }
      },
      "encoding": {
        "x": {
          "field": "tickX",
          "type": "quantitative",
          "scale": null
        },
        "x2": {
          "field": "tickX"
        },
        "y": {
          "field": "tickY0",
          "type": "quantitative",
          "scale": null
        },
        "y2": {
          "field": "tickY1"
        }
      }
    },
    {
      "description": "Status dot",
      "transform": [
        {
          "filter": "statusStyle === 'dot' && datum.rank <= datum.shown"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "opacity": 1,
        "shape": "circle"
      },
      "encoding": {
        "x": {
          "field": "dotX",
          "type": "quantitative",
          "scale": null
        },
        "y": {
          "field": "cy",
          "type": "quantitative",
          "scale": null
        },
        "size": {
          "field": "dotSize",
          "type": "quantitative",
          "scale": null
        },
        "color": {
          "field": "statusColor",
          "type": "nominal",
          "scale": null
        },
        "tooltip": [
          {
            "field": "name",
            "type": "nominal",
            "title": "KPI"
          },
          {
            "field": "valueText",
            "type": "nominal",
            "title": "Actual"
          },
          {
            "field": "targetText",
            "type": "nominal",
            "title": "Target"
          },
          {
            "field": "deltaText",
            "type": "nominal",
            "title": "Variance"
          }
        ]
      }
    },
    {
      "description": "\"+n more\" when the rows do not fit",
      "transform": [
        {
          "filter": "datum.n > datum.shown && datum.rank === datum.shown + 1"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontWeight": "normal",
        "x": {
          "expr": "pad"
        },
        "fontSize": {
          "expr": "fontSize"
        },
        "fill": {
          "expr": "mutedColor"
        },
        "fontStyle": "italic"
      },
      "encoding": {
        "y": {
          "field": "cy",
          "type": "quantitative",
          "scale": null
        },
        "text": {
          "field": "moreText",
          "type": "nominal"
        }
      }
    }
  ]
}
