          "field": "rowIn",
          "as": "firstRow"
        }
      ],
      "groupby": [
        "__0__",
        "__3__"
      ]
    },
    {
      "calculate": "datum.vN > 0 ? datum.vSum : null",
      "as": "v"
    },
    {
      "calculate": "datum.tgN > 0 ? datum.tgSum : null",
      "as": "tg"
    },
    {
      "calculate": "isValid(datum['__0__']) ? datum['__0__'] + '' : noDataText",
      "as": "name"
    },
    {
      "calculate": "isValid(datum['__3__']) ? datum['__3__'] + '' : ''",
      "as": "fmtRaw"
    },
    {
      "calculate": "datum.fmtRaw === 'auto' || (length(datum.fmtRaw) > 0 && test(/^(?:(.)?([<>=^]))?([+\\-( ])?([$#])?(0)?(\\d+)?(,)?(\\.\\d+)?(~)?([a-z%])?$/i, datum.fmtRaw)) ? datum.fmtRaw : valueFormat",
      "as": "f"
    },
    {
      "calculate": "(indexof(lowerIsBetter, datum.name) >= 0 ? -1 : 1) * (higherIsBetter ? 1 : -1)",
      "as": "dir"
    },
    {
      "calculate": "isValid(datum.v) && isValid(datum.tg) ? datum.v - datum.tg : null",
      "as": "d"
    },
    {
      "calculate": "isValid(datum.d) && datum.tg !== 0 ? datum.d / abs(datum.tg) : null",
      "as": "p"
    },
    {
      "calculate": "isValid(datum.v) && isValid(datum.tg) && datum.tg !== 0 ? datum.v / datum.tg : null",
      "as": "r"
    },
    {
      "calculate": "isValid(datum.d) ? datum.dir * datum.d : 0",
      "as": "g"
    },
    {
      "calculate": "(datum.g > 0 ? colorGood : datum.g < 0 ? colorBad : colorNeutral)",
      "as": "statusColor"
    },
    {
      "calculate": "(varianceUnit === 'points' || (varianceUnit === 'auto' && indexof(datum.f, '%') >= 0))",
      "as": "isPts"
    },
    {
      "calculate": "(!isValid(datum.v) || !isFinite(datum.v) ? noDataText : datum.f !== 'auto' ? format(datum.v, datum.f) : (datum.v < 0 ? '−' : '') + prefix + format(abs(datum.v) / (abs(datum.v) >= 999.5e6 ? 1e9 : abs(datum.v) >= 999.5e3 ? 1e6 : abs(datum.v) >= 999.5 ? 1e3 : 1), abs(datum.v) / (abs(datum.v) >= 999.5e6 ? 1e9 : abs(datum.v) >= 999.5e3 ? 1e6 : abs(datum.v) >= 999.5 ? 1e3 : 1) < 10 ? ((abs(datum.v) >= 999.5e6 ? 1e9 : abs(datum.v) >= 999.5e3 ? 1e6 : abs(datum.v) >= 999.5 ? 1e3 : 1) > 1 ? '.1f' : '.2~f') : ',.0f') + (abs(datum.v) >= 999.5e6 ? 'bn' : abs(datum.v) >= 999.5e3 ? 'M' : abs(datum.v) >= 999.5 ? 'K' : ''))",
      "as": "valueText"
    },
    {
      "calculate": "(!isValid(datum.tg) || !isFinite(datum.tg) ? noDataText : datum.f !== 'auto' ? format(datum.tg, datum.f) : (datum.tg < 0 ? '−' : '') + prefix + format(abs(datum.tg) / (abs(datum.tg) >= 999.5e6 ? 1e9 : abs(datum.tg) >= 999.5e3 ? 1e6 : abs(datum.tg) >= 999.5 ? 1e3 : 1), abs(datum.tg) / (abs(datum.tg) >= 999.5e6 ? 1e9 : abs(datum.tg) >= 999.5e3 ? 1e6 : abs(datum.tg) >= 999.5 ? 1e3 : 1) < 10 ? ((abs(datum.tg) >= 999.5e6 ? 1e9 : abs(datum.tg) >= 999.5e3 ? 1e6 : abs(datum.tg) >= 999.5 ? 1e3 : 1) > 1 ? '.1f' : '.2~f') : ',.0f') + (abs(datum.tg) >= 999.5e6 ? 'bn' : abs(datum.tg) >= 999.5e3 ? 'M' : abs(datum.tg) >= 999.5 ? 'K' : ''))",
      "as": "targetText"
    },
    {
      "calculate": "(!isValid(datum.d) ? '' : datum.d > 0 ? arrowUp : datum.d < 0 ? arrowDown : arrowFlat) + ' ' + (datum.isPts ? (!isValid(datum.d) ? noDataText : (datum.d > 0 ? '+' : datum.d < 0 ? '−' : '') + format(abs(datum.d) * 100, '.1f') + ' pts') : (!isValid(datum.p) || !isFinite(datum.p) ? noDataText : format(datum.p, pctFormat)))",
      "as": "deltaText"
    },
    {
      "calculate": "sortBy === 'value' ? (isValid(datum.v) ? -datum.v : 1e300) : sortBy === 'status' ? (isValid(datum.p) ? datum.dir * datum.p : 1e300) : sortBy === 'name' ? 0 : datum.firstRow",
      "as": "sortKey"
    },
