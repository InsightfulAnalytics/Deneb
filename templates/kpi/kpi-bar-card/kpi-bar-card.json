{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "usermeta": {
    "deneb": {
      "build": "1.9.1.0",
      "metaVersion": 1,
      "provider": "vega",
      "providerVersion": "6.2.0"
    },
    "information": {
      "name": "KPI Bar Card",
      "description": "A whole KPI card for a top performer: header band, the performer's name, month-over-month change with a coloured arrow, reporting-month and reporting-year values with their share of the total, and labelled monthly columns. Design after Gerard Duggan (dg-analysis.com).",
      "author": "Timothy Osborn, after Gerard Duggan",
      "uuid": "1101fe50-a451-4c2f-9419-b3bd347f4199",
      "generated": "2026-09-23T00:00:00.000Z",
      "previewImageBase64PNG": "data:image/png;base64,"
    },
    "dataset": [
      {
        "key": "__0__",
        "name": "Month",
        "description": "The month, one row per month of the reporting year (a month-end date works).",
        "type": "dateTime",
        "kind": "column"
      },
      {
        "key": "__1__",
        "name": "Name",
        "description": "The top performer's name, for example the top customer. The same on every row.",
        "type": "text",
        "kind": "column"
      },
      {
        "key": "__2__",
        "name": "Value",
        "description": "The performer's value for the month, for example that customer's revenue.",
        "type": "numeric",
        "kind": "measure"
      },
      {
        "key": "__3__",
        "name": "Total",
        "description": "The month's total across everyone, for example total revenue. Used for the share.",
        "type": "numeric",
        "kind": "measure"
      },
      {
        "key": "__4__",
        "name": "Is Reporting Month",
        "description": "1 on the reporting month, 0 on every other month.",
        "type": "numeric",
        "kind": "measure"
      }
    ],
    "interactivity": {
      "tooltip": true,
      "contextMenu": true,
      "selection": false,
      "highlight": false,
      "dataPointLimit": 50
    }
  },
  "config": {
    "autosize": {"type": "fit", "contains": "padding"},
    "view": {"stroke": "transparent"},
    "background": "transparent",
    "font": "Segoe UI",
    "text": {"font": "Segoe UI"}
  },
  "description": "KPI bar card",
  "padding": 0,
  "width": {"signal": "pbiContainerWidth"},
  "height": {"signal": "pbiContainerHeight"},
  "signals": [
    {"name": "title", "value": "TOP CUSTOMER"},
    {"name": "metricLabel", "value": "Rev"},
    {"name": "totalNoun", "value": "of total rev"},
    {"name": "momLabel", "value": "MoM"},
    {"name": "momJoinWord", "value": "at"},
    {"name": "reportingMonthLabel", "value": "RM"},
    {"name": "reportingYearLabel", "value": "RY"},
    {"name": "valueFormat", "value": "$,.2f"},
    {"name": "labelFormat", "value": "$,.0f"},
    {"name": "valueDivisor", "value": 1000},
    {"name": "valueSuffix", "value": "K"},
    {"name": "shareFormat", "value": ".1%"},
    {"name": "momFormat", "value": "+.1%"},
    {"name": "arrowUp", "value": "▲"},
    {"name": "arrowDown", "value": "▼"},
    {"name": "arrowFlat", "value": "►"},
    {"name": "dateFormat", "value": "%b %y"},
    {"name": "higherIsBetter", "value": true},
    {"name": "headerColor", "update": "pbiColor(0, 0.8)"},
    {"name": "headerTextColor", "value": "#252423"},
    {"name": "barColor", "update": "pbiColor(1)"},
    {"name": "barLabelColor", "value": "#FFFFFF"},
    {"name": "nameColor", "value": "#252423"},
    {"name": "statusColor", "value": "#252423"},
    {"name": "axisLabelColor", "value": "#605E5C"},
    {"name": "cardColor", "value": "#FFFFFF"},
    {"name": "borderColor", "value": "#C8C6C4"},
    {"name": "colorGood", "update": "pbiColor('good')"},
    {"name": "colorBad", "update": "pbiColor('bad')"},
    {"name": "colorNeutral", "update": "pbiColor('neutral')"},
    {"name": "headerHeight", "value": 34},
    {"name": "cardPadding", "value": 12},
    {"name": "titleFontSize", "value": 14},
    {"name": "nameFontSize", "value": 22},
    {"name": "statusFontSize", "value": 11},
    {"name": "labelFontSize", "value": 10},
    {"name": "barGap", "value": 0.28},

    {"name": "rmOrder", "update": "length(data('flagStats')) && isValid(data('flagStats')[0].lastFlagged) ? data('flagStats')[0].lastFlagged : length(data('allStats')) && isValid(data('allStats')[0].lastOrder) ? data('allStats')[0].lastOrder : null"},
    {"name": "rm", "update": "length(data('rmRow')) ? data('rmRow')[0] : null"},
    {"name": "prior", "update": "length(data('priorRows')) ? data('priorRows')[0] : null"},
    {"name": "year", "update": "length(data('allStats')) ? data('allStats')[0] : null"},
    {"name": "rmValue", "update": "rm && isValid(rm.value) ? rm.value : null"},
    {"name": "priorValue", "update": "prior && isValid(prior.value) ? prior.value : null"},
    {"name": "mom", "update": "isValid(rmValue) && isValid(priorValue) && priorValue != 0 ? (rmValue - priorValue) / abs(priorValue) : null"},
    {"name": "rmShare", "update": "isValid(rmValue) && rm && isValid(rm.total) && rm.total != 0 ? rmValue / rm.total : null"},
    {"name": "ryValue", "update": "year && year.validValue > 0 ? year.sumValue : null"},
    {"name": "ryShare", "update": "isValid(ryValue) && year.sumTotal != 0 ? ryValue / year.sumTotal : null"},
    {"name": "performer", "update": "rm && isValid(rm.name) ? '' + rm.name : ''"},
    {"name": "momArrow", "update": "!isValid(mom) ? '' : mom > 0 ? arrowUp : mom < 0 ? arrowDown : arrowFlat"},
    {"name": "momArrowColor", "update": "!isValid(mom) || mom == 0 ? colorNeutral : (mom > 0) == higherIsBetter ? colorGood : colorBad"},
    {"name": "momDetail", "update": "isValid(mom) ? momJoinWord + ' ' + format(mom, momFormat) : 'n/a'"},
    {"name": "rmLine", "update": "metricLabel + ' ' + reportingMonthLabel + ': ' + (isValid(rmValue) ? format(rmValue / valueDivisor, valueFormat) + valueSuffix : 'n/a') + ' | ' + (isValid(rmShare) ? format(rmShare, shareFormat) : 'n/a') + ' ' + totalNoun"},
    {"name": "ryLine", "update": "metricLabel + ' ' + reportingYearLabel + ': ' + (isValid(ryValue) ? format(ryValue / valueDivisor, valueFormat) + valueSuffix : 'n/a') + ' | ' + (isValid(ryShare) ? format(ryShare, shareFormat) : 'n/a') + ' ' + totalNoun"},

    {"name": "innerWidth", "update": "max(0, width - 2 * cardPadding)"},
    {"name": "wordGap", "update": "round(statusFontSize * 0.3)"},
    {"name": "nameY", "update": "headerHeight + round(nameFontSize * 0.4)"},
    {"name": "statusY", "update": "nameY + round(nameFontSize * 1.35)"},
    {"name": "statusStep", "update": "round(statusFontSize * 1.45)"},
    {"name": "chartTop", "update": "statusY + 3 * statusStep + round(statusFontSize * 0.9)"},
    {"name": "axisY", "update": "height - round(cardPadding * 0.75) - round(labelFontSize * 1.25)"},
    {"name": "chartBottom", "update": "max(chartTop, axisY - 4)"},
    {"name": "labelPad", "update": "round(labelFontSize * 0.5)"},
    {"name": "yLow", "update": "year && isValid(year.minValue) ? min(0, year.minValue) : 0"},
    {"name": "yHigh", "update": "year && isValid(year.maxValue) ? max(0, year.maxValue) : 0"},
    {"name": "monthCount", "update": "length(data('rows'))"},
    {"name": "monthStep", "update": "max(1, bandwidth('x') / max(0.01, 1 - barGap))"}
  ],
  "data": [
    {"name": "dataset"},
    {
      "name": "rows",
      "source": "dataset",
      "transform": [
        {"type": "filter", "expr": "isValid(datum['__0__'])"},
        {"type": "window", "ops": ["row_number"], "as": ["arrival"]},
        {"type": "formula", "as": "time", "expr": "isDate(datum['__0__']) || isNumber(datum['__0__']) ? time(datum['__0__']) : isString(datum['__0__']) && isValid(toDate(datum['__0__'])) ? toDate(datum['__0__']) : null"},
        {"type": "formula", "as": "order", "expr": "isValid(datum.time) ? datum.time : datum.arrival"},
        {"type": "formula", "as": "label", "expr": "isValid(datum.time) ? timeFormat(datum.time, dateFormat) : '' + datum['__0__']"},
        {"type": "formula", "as": "name", "expr": "datum['__1__']"},
        {"type": "formula", "as": "value", "expr": "isValid(datum['__2__']) ? toNumber(datum['__2__']) : null"},
        {"type": "formula", "as": "total", "expr": "isValid(datum['__3__']) ? toNumber(datum['__3__']) : null"},
        {"type": "formula", "as": "flag", "expr": "toNumber(datum['__4__']) == 1"},
        {"type": "collect", "sort": {"field": "order"}},
        {"type": "window", "sort": {"field": "order"}, "ops": ["row_number"], "as": ["rank"]}
      ]
    },
    {
      "name": "allStats",
      "source": "rows",
      "transform": [
        {
          "type": "aggregate",
          "fields": ["order", "value", "value", "total", "value", "value"],
          "ops": ["max", "sum", "valid", "sum", "min", "max"],
          "as": ["lastOrder", "sumValue", "validValue", "sumTotal", "minValue", "maxValue"]
        }
      ]
    },
    {
      "name": "flagStats",
      "source": "rows",
      "transform": [
        {"type": "filter", "expr": "datum.flag"},
        {"type": "aggregate", "fields": ["order"], "ops": ["max"], "as": ["lastFlagged"]}
      ]
    },
    {
      "name": "rmRow",
      "source": "rows",
      "transform": [{"type": "filter", "expr": "datum.order === rmOrder"}]
    },
    {
      "name": "priorRows",
      "source": "rows",
      "transform": [
        {"type": "filter", "expr": "isValid(rmOrder) && datum.order < rmOrder"},
        {"type": "collect", "sort": {"field": "order", "order": "descending"}}
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "band",
      "domain": {"data": "rows", "field": "order", "sort": true},
      "range": {"signal": "[cardPadding, width - cardPadding]"},
      "paddingInner": {"signal": "barGap"},
      "paddingOuter": {"signal": "barGap"}
    },
    {
      "name": "y",
      "type": "linear",
      "domain": {"signal": "[yLow, yHigh > yLow ? yHigh : yLow + 1]"},
      "nice": false,
      "range": {"signal": "[chartBottom, chartTop]"}
    }
  ],
  "marks": [
    {
      "type": "rect",
      "name": "card",
      "interactive": false,
      "encode": {
        "update": {
          "x": {"value": 0.5},
          "y": {"value": 0.5},
          "x2": {"signal": "width - 0.5"},
          "y2": {"signal": "height - 0.5"},
          "fill": {"signal": "cardColor"}
        }
      }
    },
    {
      "type": "rect",
      "name": "header",
      "interactive": false,
      "encode": {
        "update": {
          "x": {"value": 0.5},
          "y": {"value": 0.5},
          "x2": {"signal": "width - 0.5"},
          "y2": {"signal": "headerHeight"},
          "fill": {"signal": "headerColor"}
        }
      }
    },
    {
      "type": "text",
      "name": "titleText",
      "interactive": false,
      "encode": {
        "update": {
          "x": {"signal": "cardPadding"},
          "y": {"signal": "headerHeight / 2 + 1"},
          "baseline": {"value": "middle"},
          "text": {"signal": "title"},
          "fill": {"signal": "headerTextColor"},
          "fontSize": {"signal": "titleFontSize"},
          "fontWeight": {"value": "bold"},
          "limit": {"signal": "innerWidth"}
        }
      }
    },
    {
      "type": "text",
      "name": "nameText",
      "encode": {
        "update": {
          "x": {"signal": "cardPadding"},
          "y": {"signal": "nameY"},
          "baseline": {"value": "top"},
          "text": {"signal": "performer"},
          "fill": {"signal": "nameColor"},
          "fontSize": {"signal": "nameFontSize"},
          "fontWeight": {"value": "bold"},
          "limit": {"signal": "innerWidth"},
          "tooltip": {"signal": "{'Name': performer}"}
        }
      }
    },
    {
      "type": "text",
      "name": "momLabelText",
      "interactive": false,
      "encode": {
        "update": {
          "x": {"signal": "cardPadding"},
          "y": {"signal": "statusY"},
          "baseline": {"value": "top"},
          "text": {"signal": "momLabel"},
          "fill": {"signal": "statusColor"},
          "fontSize": {"signal": "statusFontSize"}
        }
      }
    },
    {
      "type": "text",
      "name": "momArrowText",
      "from": {"data": "momLabelText"},
      "interactive": false,
      "encode": {
        "update": {
          "x": {"signal": "datum.bounds.x2 + (datum.text ? wordGap : 0)"},
          "y": {"signal": "statusY"},
          "baseline": {"value": "top"},
          "text": {"signal": "momArrow"},
          "fill": {"signal": "momArrowColor"},
          "fontSize": {"signal": "statusFontSize"}
        }
      }
    },
    {
      "type": "text",
      "name": "momDetailText",
      "from": {"data": "momArrowText"},
      "interactive": false,
      "encode": {
        "update": {
          "x": {"signal": "datum.bounds.x2 + (datum.text ? wordGap : 0)"},
          "y": {"signal": "statusY"},
          "baseline": {"value": "top"},
          "text": {"signal": "momDetail"},
          "fill": {"signal": "statusColor"},
          "fontSize": {"signal": "statusFontSize"},
          "limit": {"signal": "max(1, width - cardPadding - datum.bounds.x2 - wordGap)"}
        }
      }
    },
    {
      "type": "text",
      "name": "rmLineText",
      "interactive": false,
      "encode": {
        "update": {
          "x": {"signal": "cardPadding"},
          "y": {"signal": "statusY + statusStep"},
          "baseline": {"value": "top"},
          "text": {"signal": "rmLine"},
          "fill": {"signal": "statusColor"},
          "fontSize": {"signal": "statusFontSize"},
          "limit": {"signal": "innerWidth"}
        }
      }
    },
    {
      "type": "text",
      "name": "ryLineText",
      "interactive": false,
      "encode": {
        "update": {
          "x": {"signal": "cardPadding"},
          "y": {"signal": "statusY + 2 * statusStep"},
          "baseline": {"value": "top"},
          "text": {"signal": "ryLine"},
          "fill": {"signal": "statusColor"},
          "fontSize": {"signal": "statusFontSize"},
          "limit": {"signal": "innerWidth"}
        }
      }
    },
    {
      "type": "rect",
      "name": "bars",
      "from": {"data": "rows"},
      "encode": {
        "update": {
          "x": {"scale": "x", "field": "order"},
          "width": {"scale": "x", "band": 1},
          "y": {"scale": "y", "signal": "isValid(datum.value) ? datum.value : 0"},
          "y2": {"scale": "y", "value": 0},
          "fill": {"signal": "barColor"},
          "tooltip": {"signal": "{'Name': datum.name, 'Month': datum.label, 'Value': isValid(datum.value) ? format(datum.value / valueDivisor, valueFormat) + valueSuffix : 'n/a', 'Share of total': isValid(datum.value) && datum.total ? format(datum.value / datum.total, shareFormat) : 'n/a'}"}
        }
      }
    },
    {
      "type": "text",
      "name": "barLabelProbe",
      "from": {"data": "rows"},
      "interactive": false,
      "encode": {
        "update": {
          "x": {"value": 0},
          "y": {"signal": "scale('y', max(0, isValid(datum.value) ? datum.value : 0)) + labelPad"},
          "align": {"value": "left"},
          "baseline": {"value": "top"},
          "text": {"signal": "isValid(datum.value) && datum.value > 0 ? format(datum.value / valueDivisor, labelFormat) + valueSuffix : ''"},
          "fontSize": {"signal": "labelFontSize"},
          "limit": {"signal": "innerWidth"},
          "opacity": {"value": 0}
        }
      }
    },
    {
      "type": "text",
      "name": "barLabels",
      "from": {"data": "barLabelProbe"},
      "interactive": false,
      "encode": {
        "update": {
          "x": {"scale": "x", "field": "datum.order", "band": 0.5},
          "y": {"field": "y"},
          "align": {"value": "center"},
          "baseline": {"value": "top"},
          "text": {"field": "text"},
          "fill": {"signal": "barLabelColor"},
          "fontSize": {"signal": "labelFontSize"},
          "opacity": {"signal": "datum.text && (extent(pluck(data('barLabelProbe') || [], 'bounds.x2'))[1] || 0) <= bandwidth('x') - 4 && scale('y', 0) - scale('y', datum.datum.value) >= labelFontSize + 2 * labelPad ? 1 : 0"}
        }
      }
    },
    {
      "type": "text",
      "name": "monthLabelProbe",
      "from": {"data": "rows"},
      "interactive": false,
      "encode": {
        "update": {
          "x": {"signal": "cardPadding"},
          "y": {"signal": "axisY"},
          "align": {"value": "left"},
          "baseline": {"value": "top"},
          "text": {"field": "label"},
          "fontSize": {"signal": "labelFontSize"},
          "limit": {"signal": "innerWidth"},
          "opacity": {"value": 0}
        }
      }
    },
    {
      "type": "text",
      "name": "monthLabels",
      "from": {"data": "monthLabelProbe"},
      "interactive": false,
      "encode": {
        "update": {
          "x": {"scale": "x", "field": "datum.order", "band": 0.5},
          "y": {"signal": "axisY"},
          "align": {"value": "center"},
          "baseline": {"value": "top"},
          "text": {"signal": "(monthCount - datum.datum.rank) % max(1, ceil(((extent(pluck(data('monthLabelProbe') || [], 'bounds.x2'))[1] || cardPadding) - cardPadding + labelPad) / monthStep)) == 0 ? datum.datum.label : ''"},
          "fill": {"signal": "axisLabelColor"},
          "fontSize": {"signal": "labelFontSize"},
          "limit": {"signal": "max(1, max(1, ceil(((extent(pluck(data('monthLabelProbe') || [], 'bounds.x2'))[1] || cardPadding) - cardPadding + labelPad) / monthStep)) * monthStep - labelPad)"}
        }
      }
    },
    {
      "type": "rect",
      "name": "border",
      "interactive": false,
      "encode": {
        "update": {
          "x": {"value": 0.5},
          "y": {"value": 0.5},
          "x2": {"signal": "width - 0.5"},
          "y2": {"signal": "height - 0.5"},
          "fill": {"value": "transparent"},
          "stroke": {"signal": "borderColor"},
          "strokeWidth": {"value": 1}
        }
      }
    }
  ]
}
