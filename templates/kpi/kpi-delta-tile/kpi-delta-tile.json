    "information": {
      "name": "KPI Delta Tile",
      "description": "The plainest KPI card: the value, its change against a benchmark (prior year, prior period or target) as an amount and a percentage, and an arrow coloured good or bad. Side by side in a band tile, stacked in a taller card. Design by Timothy Osborn.",
      "author": "Timothy Osborn",
      "uuid": "9e25ca3e-e0fc-42be-a405-4acdd680773b",
      "generated": "2026-10-18T00:00:00.000Z",
      "previewImageBase64PNG": "data:image/png;base64,"
    },
    "dataset": [
      {
        "key": "__0__",
        "name": "Value",
        "description": "The KPI, for example sales this month.",
        "type": "numeric",
        "kind": "measure"
      },
      {
        "key": "__1__",
        "name": "Benchmark",
        "description": "What Value is compared with: prior year, prior period, budget or target. Name it in comparisonLabel.",
        "type": "numeric",
        "kind": "measure"
      }
    ],
    "interactivity": {
      "tooltip": true,
      "contextMenu": true,
      "selection": false,
      "highlight": false,
      "dataPointLimit": 50
    }
  },
  "config": {
