        },
        {
          "calculate": "datum.pts === 0 ? plotX0 + ((datum.tMin) - datum.tMin) / (datum.pe - datum.tMin) * (plotX1 - plotX0) : datum.pts === 2 ? plotX0 + ((datum.pe) - datum.tMin) / (datum.pe - datum.tMin) * (plotX1 - plotX0) : plotX0 + ((datum.t + datum.step) - datum.tMin) / (datum.pe - datum.tMin) * (plotX1 - plotX0)",
          "as": "tx"
        },
        {
          "calculate": "datum.pts === 0 ? plotY1 - (0) / datum.yMax * (plotY1 - plotY0) : datum.pts === 2 ? plotY1 - (datum.target) / datum.yMax * (plotY1 - plotY0) : plotY1 - (datum.cumT) / datum.yMax * (plotY1 - plotY0)",
          "as": "ty"
        }
      ],
      "mark": {
        "type": "line",
        "stroke": {
          "expr": "targetLineColor"
        },
        "strokeWidth": {
          "expr": "1.5 * unit"
        },
        "strokeDash": [
          2,
          2
        ]
      },
      "encoding": {
        "x": {
          "field": "tx",
          "type": "quantitative",
          "scale": null
        },
        "y": {
          "field": "ty",
          "type": "quantitative",
          "scale": null
        }
      }
    },
    {
      "description": "Line at the last day with data",
      "transform": [
        {
          "filter": "datum.k === 1 && datum.elapsedEnd < datum.pe"
        },
        {
          "calculate": "plotX0 + ((datum.elapsedEnd) - datum.tMin) / (datum.pe - datum.tMin) * (plotX1 - plotX0)",
          "as": "lx"
        },
        {
          "calculate": "plotY0",
          "as": "ly0"
        },
        {
          "calculate": "plotY1",
          "as": "ly1"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": {
          "expr": "todayLineColor"
        },
        "strokeWidth": 1,
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "x": {
          "field": "lx",
          "type": "quantitative",
          "scale": null
        },
        "x2": {
          "field": "lx"
        },
        "y": {
          "field": "ly0",
          "type": "quantitative",
          "scale": null
        },
        "y2": {
          "field": "ly1"
        }
      }
    },
    {
      "description": "Projection: dashed from the last actual to the period end",
      "transform": [
        {
          "filter": "datum.t === datum.lastT"
        },
        {
          "calculate": "[0, 1]",
          "as": "pts"
        },
        {
          "flatten": [
            "pts"
          ]
        },
        {
          "calculate": "datum.pts === 0 ? plotX0 + ((datum.elapsedEnd) - datum.tMin) / (datum.pe - datum.tMin) * (plotX1 - plotX0) : plotX0 + ((datum.pe) - datum.tMin) / (datum.pe - datum.tMin) * (plotX1 - plotX0)",
          "as": "qx"
        },
        {
          "calculate": "datum.pts === 0 ? plotY1 - (datum.actual) / datum.yMax * (plotY1 - plotY0) : plotY1 - (datum.proj) / datum.yMax * (plotY1 - plotY0)",
          "as": "qy"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": {
          "expr": "2 * unit"
        },
        "strokeDash": [
          4,
          3
        ]
      },
      "encoding": {
        "x": {
          "field": "qx",
          "type": "quantitative",
          "scale": null
        },
        "y": {
          "field": "qy",
          "type": "quantitative",
          "scale": null
        },
        "color": {
          "field": "projColor",
          "type": "nominal",
          "scale": null
        }
      }
    },
    {
      "description": "Projection end point",
      "transform": [
        {
          "filter": "datum.t === datum.lastT && isValid(datum.proj)"
        },
        {
          "calculate": "plotX0 + ((datum.pe) - datum.tMin) / (datum.pe - datum.tMin) * (plotX1 - plotX0)",
          "as": "ex"
        },
        {
          "calculate": "plotY1 - (datum.proj) / datum.yMax * (plotY1 - plotY0)",
          "as": "ey"
        },
        {
          "calculate": "PI * pow(3.5 * unit, 2)",
          "as": "es"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "opacity": 1,
        "shape": "circle"
      },
      "encoding": {
        "x": {
          "field": "ex",
          "type": "quantitative",
          "scale": null
        },
        "y": {
          "field": "ey",
          "type": "quantitative",
          "scale": null
        },
        "size": {
          "field": "es",
          "type": "quantitative",
          "scale": null
        },
        "color": {
          "field": "projColor",
          "type": "nominal",
          "scale": null
        },
        "tooltip": [
          {
            "field": "projText",
            "type": "nominal",
            "title": "Projected"
          },
          {
            "field": "targetText",
            "type": "nominal",
            "title": "Target"
          },
          {
            "field": "shareText",
            "type": "nominal",
            "title": "Of target"
          }
        ]
      }
    },
    {
      "description": "Dates under the chart: start, last actual, end (stacked only)",
      "transform": [
        {
          "filter": "stacked && datum.k === 1"
        },
        {
          "calculate": "[0, 1, 2]",
          "as": "li"
        },
        {
          "flatten": [
            "li"
          ]
        },
        {
          "calculate": "datum.li === 0 ? plotX0 : datum.li === 2 ? plotX1 : plotX0 + ((datum.elapsedEnd) - datum.tMin) / (datum.pe - datum.tMin) * (plotX1 - plotX0)",
          "as": "lx"
        },
        {
          "calculate": "timeFormat(datum.li === 0 ? datum.tMin : datum.li === 2 ? datum.pe - 864e5 : datum.lastT, dateFormat)",
          "as": "lt"
        },
        {
          "filter": "datum.li !== 1 || (datum.lx - plotX0 > 40 * unit && plotX1 - datum.lx > 40 * unit)"
        }
      ],
      "layer": [
        {
          "transform": [
            {
              "filter": "datum.li === 0"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "alphabetic",
            "y": {
              "expr": "labelY"
            },
            "fontSize": {
              "expr": "labelSize"
            },
            "fill": {
              "expr": "mutedColor"
            }
          },
          "encoding": {
            "text": {
              "field": "lt",
              "type": "nominal"
            },
            "x": {
              "field": "lx",
              "type": "quantitative",
              "scale": null
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.li === 1"
            }
          ],
          "mark": {
            "type": "text",
            "align": "center",
            "baseline": "alphabetic",
            "y": {
              "expr": "labelY"
            },
            "fontSize": {
              "expr": "labelSize"
            },
            "fill": {
              "expr": "mutedColor"
            }
          },
          "encoding": {
            "text": {
              "field": "lt",
              "type": "nominal"
            },
            "x": {
              "field": "lx",
              "type": "quantitative",
              "scale": null
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.li === 2"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "alphabetic",
            "y": {
              "expr": "labelY"
            },
            "fontSize": {
              "expr": "labelSize"
            },
            "fill": {
              "expr": "mutedColor"
            }
          },
          "encoding": {
            "text": {
              "field": "lt",
              "type": "nominal"
            },
            "x": {
              "field": "lx",
              "type": "quantitative",
              "scale": null
            }
          }
        }
      ]
    }
  ]
}
