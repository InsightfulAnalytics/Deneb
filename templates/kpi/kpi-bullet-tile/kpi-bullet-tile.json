  "transform": [
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "__0__",
          "as": "vSum"
        },
        {
          "op": "valid",
          "field": "__0__",
          "as": "vN"
        },
        {
          "op": "sum",
          "field": "__1__",
          "as": "tgSum"
        },
        {
          "op": "valid",
          "field": "__1__",
          "as": "tgN"
        }
      ]
    },
    {
      "calculate": "datum.vN > 0 ? datum.vSum : null",
      "as": "v"
    },
    {
      "calculate": "datum.tgN > 0 ? datum.tgSum : null",
      "as": "tg"
    },
    {
      "calculate": "isValid(datum.v) && isValid(datum.tg) ? datum.v - datum.tg : null",
      "as": "d"
    },
    {
      "calculate": "isValid(datum.d) && datum.tg !== 0 ? datum.d / abs(datum.tg) : null",
      "as": "p"
    },
    {
      "calculate": "isValid(datum.v) && isValid(datum.tg) && datum.tg !== 0 ? datum.v / datum.tg : null",
      "as": "r"
    },
    {
      "calculate": "isValid(datum.d) ? (higherIsBetter ? 1 : -1) * datum.d : 0",
      "as": "g"
    },
    {
      "calculate": "(datum.g > 0 ? colorGood : datum.g < 0 ? colorBad : colorNeutral)",
      "as": "statusColor"
    },
    {
      "calculate": "(varianceUnit === 'points' || (varianceUnit === 'auto' && indexof(valueFormat, '%') >= 0))",
      "as": "isPts"
    },
    {
      "calculate": "(!isValid(datum.v) || !isFinite(datum.v) ? noDataText : valueFormat !== 'auto' ? format(datum.v, valueFormat) : (datum.v < 0 ? '−' : '') + prefix + format(abs(datum.v) / (abs(datum.v) >= 999.5e6 ? 1e9 : abs(datum.v) >= 999.5e3 ? 1e6 : abs(datum.v) >= 999.5 ? 1e3 : 1), abs(datum.v) / (abs(datum.v) >= 999.5e6 ? 1e9 : abs(datum.v) >= 999.5e3 ? 1e6 : abs(datum.v) >= 999.5 ? 1e3 : 1) < 10 ? ((abs(datum.v) >= 999.5e6 ? 1e9 : abs(datum.v) >= 999.5e3 ? 1e6 : abs(datum.v) >= 999.5 ? 1e3 : 1) > 1 ? '.1f' : '.2~f') : ',.0f') + (abs(datum.v) >= 999.5e6 ? 'bn' : abs(datum.v) >= 999.5e3 ? 'M' : abs(datum.v) >= 999.5 ? 'K' : ''))",
      "as": "valueText"
    },
    {
      "calculate": "(!isValid(datum.tg) || !isFinite(datum.tg) ? noDataText : valueFormat !== 'auto' ? format(datum.tg, valueFormat) : (datum.tg < 0 ? '−' : '') + prefix + format(abs(datum.tg) / (abs(datum.tg) >= 999.5e6 ? 1e9 : abs(datum.tg) >= 999.5e3 ? 1e6 : abs(datum.tg) >= 999.5 ? 1e3 : 1), abs(datum.tg) / (abs(datum.tg) >= 999.5e6 ? 1e9 : abs(datum.tg) >= 999.5e3 ? 1e6 : abs(datum.tg) >= 999.5 ? 1e3 : 1) < 10 ? ((abs(datum.tg) >= 999.5e6 ? 1e9 : abs(datum.tg) >= 999.5e3 ? 1e6 : abs(datum.tg) >= 999.5 ? 1e3 : 1) > 1 ? '.1f' : '.2~f') : ',.0f') + (abs(datum.tg) >= 999.5e6 ? 'bn' : abs(datum.tg) >= 999.5e3 ? 'M' : abs(datum.tg) >= 999.5 ? 'K' : ''))",
      "as": "targetText"
    },
    {
      "calculate": "(!isValid(datum.d) ? '' : datum.d > 0 ? arrowUp : datum.d < 0 ? arrowDown : arrowFlat) + ' ' + (datum.isPts ? (!isValid(datum.d) ? noDataText : (datum.d > 0 ? '+' : datum.d < 0 ? '−' : '') + format(abs(datum.d) * 100, '.1f') + ' pts') : (isValid(datum.d) && datum.d > 0 ? '+' : '') + (!isValid(datum.d) || !isFinite(datum.d) ? noDataText : valueFormat !== 'auto' ? format(datum.d, valueFormat) : (datum.d < 0 ? '−' : '') + prefix + format(abs(datum.d) / (abs(datum.d) >= 999.5e6 ? 1e9 : abs(datum.d) >= 999.5e3 ? 1e6 : abs(datum.d) >= 999.5 ? 1e3 : 1), abs(datum.d) / (abs(datum.d) >= 999.5e6 ? 1e9 : abs(datum.d) >= 999.5e3 ? 1e6 : abs(datum.d) >= 999.5 ? 1e3 : 1) < 10 ? ((abs(datum.d) >= 999.5e6 ? 1e9 : abs(datum.d) >= 999.5e3 ? 1e6 : abs(datum.d) >= 999.5 ? 1e3 : 1) > 1 ? '.1f' : '.2~f') : ',.0f') + (abs(datum.d) >= 999.5e6 ? 'bn' : abs(datum.d) >= 999.5e3 ? 'M' : abs(datum.d) >= 999.5 ? 'K' : '')) + ' (' + (!isValid(datum.p) || !isFinite(datum.p) ? noDataText : format(datum.p, pctFormat)) + ')')",
      "as": "gapText"
    },
    {
      "calculate": "max(scaleMax, 1.04, isValid(datum.r) ? datum.r * 1.04 : 0)",
      "as": "scaleEnd"
    },
    {
      "calculate": "bulletX0 + (clamp(isValid(datum.r) ? datum.r : 0, 0, datum.scaleEnd)) / datum.scaleEnd * (bulletX1 - bulletX0)",
      "as": "barEnd"
    },
    {
      "calculate": "bulletX0 + (1) / datum.scaleEnd * (bulletX1 - bulletX0)",
      "as": "targetX"
    },
    {
      "calculate": "targetLabel + ' ' + datum.targetText",
      "as": "targetLabelText"
    },
    {
      "calculate": "min(max(datum.targetX, bulletX0 + labelSize * 0.29 * length(datum.targetLabelText)), bulletX1 - labelSize * 0.29 * length(datum.targetLabelText))",
      "as": "targetLabelX"
    },
    {
      "calculate": "colorBarByStatus ? datum.statusColor : barColor",
      "as": "barFill"
    },
    {
      "calculate": "bulletX0",
      "as": "bx0"
    },
    {
      "calculate": "barY0",
      "as": "by0"
    },
    {
      "calculate": "barY1",
