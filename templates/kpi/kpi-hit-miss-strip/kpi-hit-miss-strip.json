        },
        "fontSize": {
          "expr": "labelSize"
        },
        "fill": {
          "expr": "mutedColor"
        }
      },
      "encoding": {
        "x": {
          "field": "cx",
          "type": "quantitative",
          "scale": null
        },
        "text": {
          "field": "lblShort",
          "type": "nominal"
        }
      }
    }
  ]
}
