    {
      "description": "Daily gap: areas and a thin line, split at the zero-gap baseline so each side takes its own colour.",
      "transform": [
        {"filter": "datum.inWindow && isValid(datum.gap)"},
        {"calculate": "datum.gap >= 0 ? 1 : -1", "as": "gapSign"},
        {
          "window": [
            {"op": "lead", "field": "gap", "as": "nextGap"},
            {"op": "lead", "field": "dayNumber", "as": "nextDay"},
            {"op": "lag", "field": "gapSign", "as": "previousSign"}
          ],
          "sort": [{"field": "dayNumber", "order": "ascending"}]
        },
        {"calculate": "isValid(datum.previousSign) && datum.previousSign != datum.gapSign ? 1 : 0", "as": "signFlip"},
        {
          "window": [{"op": "sum", "field": "signFlip", "as": "run"}],
          "sort": [{"field": "dayNumber", "order": "ascending"}],
          "frame": [null, 0]
        },
        {"calculate": "isValid(datum.nextGap) && (datum.nextGap >= 0 ? 1 : -1) != datum.gapSign ? datum.dayNumber + (datum.nextDay - datum.dayNumber) * datum.gap / (datum.gap - datum.nextGap) : null", "as": "crossDay"},
        {"calculate": "isValid(datum.crossDay) ? [{x: datum.dayNumber, y: datum.gap, run: datum.run, side: datum.gapSign}, {x: datum.crossDay, y: 0, run: datum.run, side: datum.gapSign}, {x: datum.crossDay, y: 0, run: datum.run + 1, side: -datum.gapSign}] : [{x: datum.dayNumber, y: datum.gap, run: datum.run, side: datum.gapSign}]", "as": "pathPoints"},
        {"flatten": ["pathPoints"], "as": ["pathPoint"]},
