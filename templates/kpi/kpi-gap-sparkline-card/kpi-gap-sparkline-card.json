  "padding": 0,
  "params": [
    {"name": "title", "value": "Orders MTD (€)"},
    {"name": "comparisonLabel", "value": "MTD LY"},
    {"name": "gapLabel", "value": "GAP"},
    {"name": "windowDays", "value": 30},
    {"name": "avgDays", "value": 5},
    {"name": "windowLabel", "expr": "'LAST ' + windowDays + ' DAYS'"},
    {"name": "dailyGapLabel", "value": "DAILY GAP"},
    {"name": "avgLabel", "expr": "avgDays + 'D AVG'"},
    {"name": "todayLabel", "value": "TODAY"},
    {"name": "valueFormat", "value": ".3~s"},
    {"name": "todayFormat", "value": ".2~s"},
    {"name": "pctFormat", "value": ".1%"},
    {"name": "tooltipFormat", "value": ",.0f"},
    {"name": "arrowUp", "value": "↗"},
    {"name": "arrowDown", "value": "↘"},
    {"name": "arrowFlat", "value": "→"},
    {"name": "higherIsBetter", "value": true},
    {"name": "drawCardFrame", "value": true},
    {"name": "colorGood", "expr": "pbiColor('good')"},
    {"name": "colorBad", "expr": "pbiColor('bad')"},
    {"name": "textPrimary", "value": "#323130"},
    {"name": "textSecondary", "value": "#605E5C"},
    {"name": "textMuted", "value": "#A19F9D"},
    {"name": "avgLineColor", "value": "#323130"},
    {"name": "separatorColor", "value": "#E8E6E3"},
    {"name": "frameColor", "value": "#1F1F1F"},
    {"name": "cardColor", "value": "#FFFFFF"},
    {"name": "cornerRadius", "value": 8},
    {"name": "cardPadding", "value": 24},
    {"name": "valueFontSize", "value": 40},
    {"name": "areaOpacity", "value": 0.3},
    {"name": "colorAbove", "expr": "higherIsBetter ? colorGood : colorBad"},
    {"name": "colorBelow", "expr": "higherIsBetter ? colorBad : colorGood"},
    {"name": "fillAbove", "expr": "{gradient: 'linear', x1: 0, y1: 0, x2: 0, y2: 1, stops: [{offset: 0, color: 'rgba(' + rgb(colorAbove).r + ',' + rgb(colorAbove).g + ',' + rgb(colorAbove).b + ',' + areaOpacity + ')'}, {offset: 1, color: 'rgba(' + rgb(colorAbove).r + ',' + rgb(colorAbove).g + ',' + rgb(colorAbove).b + ',0)'}]}"},
    {"name": "fillBelow", "expr": "{gradient: 'linear', x1: 0, y1: 0, x2: 0, y2: 1, stops: [{offset: 0, color: 'rgba(' + rgb(colorBelow).r + ',' + rgb(colorBelow).g + ',' + rgb(colorBelow).b + ',0)'}, {offset: 1, color: 'rgba(' + rgb(colorBelow).r + ',' + rgb(colorBelow).g + ',' + rgb(colorBelow).b + ',' + areaOpacity + ')'}]}"},
    {"name": "layoutScale", "expr": "clamp(min(width / 360, height / 280), 0.6, 2)"},
    {"name": "layoutLeft", "expr": "cardPadding * layoutScale + 1"},
    {"name": "layoutRight", "expr": "width - cardPadding * layoutScale - 3"},
    {"name": "layoutTop", "expr": "(cardPadding - 2) * layoutScale + 1"},
    {"name": "layoutBottom", "expr": "height - (cardPadding - 6) * layoutScale - 3"},
    {"name": "layoutColumn", "expr": "layoutLeft + 0.55 * (layoutRight - layoutLeft)"},
    {"name": "layoutSparkTop", "expr": "layoutTop + 143 * layoutScale"},
    {"name": "layoutSparkBottom", "expr": "max(layoutSparkTop + 20, layoutBottom - 3 * layoutScale)"},
    {"name": "layoutSparkLeft", "expr": "layoutLeft + 4 * layoutScale"},
    {"name": "layoutSparkRight", "expr": "layoutRight - 4 * layoutScale"},
    {"name": "layoutHeaderY", "expr": "layoutTop + 125 * layoutScale"},
    {"name": "layoutLegendGapWidth", "expr": "length(dailyGapLabel) * 9 * 0.6 * layoutScale"},
    {"name": "layoutLegendAvgWidth", "expr": "length(avgLabel) * 9 * 0.6 * layoutScale"},
    {"name": "layoutLegendX", "expr": "layoutRight - 54 * layoutScale - layoutLegendGapWidth - layoutLegendAvgWidth"},
    {"name": "layoutLegendAvgX", "expr": "layoutLegendX + 33 * layoutScale + layoutLegendGapWidth"}
  ],
  "data": {"name": "dataset"},
  "transform": [
    {"calculate": "toDate(datum['__0__'])", "as": "dayDate"},
    {"calculate": "isValid(datum['__1__']) ? toNumber(datum['__1__']) : null", "as": "dayActual"},
    {"calculate": "isValid(datum['__2__']) ? toNumber(datum['__2__']) : null", "as": "dayComparison"},
    {"filter": "isValid(datum.dayDate) && isFinite(time(datum.dayDate))"},
    {"calculate": "round(utc(year(datum.dayDate), month(datum.dayDate), date(datum.dayDate)) / 864e5)", "as": "dayNumber"},
    {"calculate": "isValid(datum.dayActual) ? datum.dayNumber : null", "as": "dayWithActual"},
    {"joinaggregate": [{"op": "max", "field": "dayWithActual", "as": "today"}]},
    {"filter": "isValid(datum.today) && datum.dayNumber <= datum.today"},
    {"calculate": "year(datum.dayDate) * 12 + month(datum.dayDate) == utcyear(datum.today * 864e5) * 12 + utcmonth(datum.today * 864e5)", "as": "inMonth"},
    {"calculate": "datum.dayNumber > datum.today - windowDays", "as": "inWindow"},
    {"calculate": "datum.inMonth ? datum.dayActual : null", "as": "monthActual"},
    {"calculate": "datum.inMonth ? datum.dayComparison : null", "as": "monthComparison"},
    {"calculate": "isValid(datum.dayActual) && isValid(datum.dayComparison) ? datum.dayActual - datum.dayComparison : null", "as": "gap"},
    {"calculate": "sequence(0, max(1, avgDays))", "as": "avgOffsets"},
    {"flatten": ["avgOffsets"], "as": ["avgOffset"]},
    {"calculate": "datum.dayNumber + datum.avgOffset", "as": "avgTarget"},
    {"joinaggregate": [{"op": "mean", "field": "gap", "as": "avgGap"}], "groupby": ["avgTarget"]},
    {"filter": "datum.avgOffset == 0"},
    {"calculate": "datum.inWindow ? datum.gap : null", "as": "windowGap"},
    {"calculate": "datum.inWindow ? datum.avgGap : null", "as": "windowAvg"},
    {"calculate": "datum.dayNumber == datum.today ? datum.gap : null", "as": "todayGapOnly"},
    {
      "joinaggregate": [
        {"op": "sum", "field": "monthActual", "as": "mtdActual"},
        {"op": "sum", "field": "monthComparison", "as": "mtdComparison"},
        {"op": "min", "field": "windowGap", "as": "windowGapMin"},
        {"op": "max", "field": "windowGap", "as": "windowGapMax"},
        {"op": "min", "field": "windowAvg", "as": "windowAvgMin"},
        {"op": "max", "field": "windowAvg", "as": "windowAvgMax"},
        {"op": "max", "field": "todayGapOnly", "as": "todayGap"}
      ]
    },
    {"calculate": "datum.mtdActual - datum.mtdComparison", "as": "mtdGap"},
    {"calculate": "datum.mtdComparison ? datum.mtdGap / abs(datum.mtdComparison) : null", "as": "mtdGapPct"},
    {"calculate": "datum.mtdGap > 0 ? 1 : datum.mtdGap < 0 ? -1 : 0", "as": "mtdSign"},
    {"calculate": "datum.mtdSign > 0 ? arrowUp : datum.mtdSign < 0 ? arrowDown : arrowFlat", "as": "mtdArrow"},
    {"calculate": "datum.mtdSign == 0 ? textSecondary : (datum.mtdSign > 0) == higherIsBetter ? colorGood : colorBad", "as": "mtdColor"},
    {"calculate": "replace(format(datum.mtdActual, valueFormat), 'G', 'B')", "as": "mtdActualText"},
    {"calculate": "replace(format(datum.mtdComparison, valueFormat), 'G', 'B')", "as": "mtdComparisonText"},
    {"calculate": "datum.mtdArrow + replace(format(abs(datum.mtdGap), valueFormat), 'G', 'B') + (isValid(datum.mtdGapPct) ? ' (' + datum.mtdArrow + format(abs(datum.mtdGapPct), pctFormat) + ')' : '')", "as": "mtdGapText"},
    {"calculate": "datum.todayGap > 0 ? 1 : datum.todayGap < 0 ? -1 : 0", "as": "todaySign"},
    {"calculate": "isValid(datum.todayGap) ? (datum.todaySign > 0 ? arrowUp : datum.todaySign < 0 ? arrowDown : arrowFlat) + replace(format(abs(datum.todayGap), todayFormat), 'G', 'B') : ''", "as": "todayText"},
    {"calculate": "datum.todaySign == 0 ? textSecondary : datum.todaySign > 0 ? colorAbove : colorBelow", "as": "todayColor"},
    {"calculate": "(datum.todayGap - min(0, datum.windowGapMin, datum.windowAvgMin)) / max(1e-9, max(0, datum.windowGapMax, datum.windowAvgMax) - min(0, datum.windowGapMin, datum.windowAvgMin)) > 0.6", "as": "calloutLow"},
    {"calculate": "datum.gap >= 0 ? colorAbove : colorBelow", "as": "gapColor"},
    {"calculate": "timeFormat(datum.dayDate, '%a %d %b %Y')", "as": "tipDate"},
    {"calculate": "isValid(datum.dayActual) ? format(datum.dayActual, tooltipFormat) : ''", "as": "tipActual"},
    {"calculate": "isValid(datum.dayComparison) ? format(datum.dayComparison, tooltipFormat) : ''", "as": "tipComparison"},
    {"calculate": "isValid(datum.gap) ? format(datum.gap, tooltipFormat) : ''", "as": "tipGap"},
    {"calculate": "isValid(datum.avgGap) ? format(datum.avgGap, tooltipFormat) : ''", "as": "tipAvg"}
  ],
