    "information": {
      "name": "KPI Gap Sparkline Card",
      "description": "Month-to-date KPI card: the MTD value, its comparison (last year or a target) and the gap with an arrow and a good or bad colour, over a sparkline of the daily gap with a trailing moving average. Design after Ruben Van de Voorde (tabulareditor.com).",
      "author": "Timothy Osborn, after Ruben Van de Voorde (Tabular Editor)",
      "uuid": "e207fa9f-c9f1-4519-adcd-8e88a564de3f",
      "generated": "2026-09-23T00:00:00.000Z",
      "previewImageBase64PNG": "data:image/png;base64,"
    },
    "dataset": [
      {
        "key": "__0__",
        "name": "Date",
        "description": "The day. One row per day; the latest day with an Actual value is today.",
        "type": "dateTime",
        "kind": "column"
      },
      {
        "key": "__1__",
        "name": "Actual",
        "description": "The value for the day, for example orders in euros.",
        "type": "numeric",
        "kind": "measure"
      },
      {
        "key": "__2__",
        "name": "Comparison",
        "description": "The same day last year, or a daily target.",
        "type": "numeric",
        "kind": "measure"
      }
    ],
    "interactivity": {
      "tooltip": true,
      "contextMenu": true,
      "selection": false,
      "highlight": false,
      "dataPointLimit": 50
    }
  },
  "config": {
    "autosize": {"type": "fit", "contains": "padding"},
    "view": {"stroke": "transparent"},
    "background": "transparent",
