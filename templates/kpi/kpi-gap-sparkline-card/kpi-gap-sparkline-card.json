        },
        {
          "transform": [{"filter": "isValid(datum.avgGap)"}],
          "mark": {"type": "line", "interpolate": "monotone", "strokeWidth": 1.75, "strokeJoin": "round", "strokeCap": "round", "stroke": {"expr": "avgLineColor"}},
          "encoding": {
            "x": {"field": "dayNumber", "type": "quantitative", "axis": null},
            "y": {"field": "avgGap", "type": "quantitative", "axis": null}
          }
        },
        {
          "transform": [{"filter": "datum.dayNumber == datum.today && isValid(datum.gap)"}],
          "mark": {"type": "point", "shape": "circle", "filled": true, "size": {"expr": "30 * layoutScale * layoutScale"}, "opacity": 1},
          "encoding": {
            "x": {"field": "dayNumber", "type": "quantitative", "axis": null},
            "y": {"field": "gap", "type": "quantitative", "axis": null},
            "color": {"field": "todayColor", "type": "nominal", "scale": null, "legend": null},
            "tooltip": [
              {"field": "tipDate", "type": "nominal", "title": "__0__"},
              {"field": "tipActual", "type": "nominal", "title": "__1__"},
              {"field": "tipComparison", "type": "nominal", "title": "__2__"},
              {"field": "tipGap", "type": "nominal", "title": "Daily gap"},
              {"field": "tipAvg", "type": "nominal", "title": "Trailing average"}
            ]
          }
        }
      ]
    },
    {
      "description": "Today callout: top right of the sparkline, or bottom right when today sits high, on a card-coloured plate so a line under it cannot clash.",
      "transform": [{"filter": "datum.dayNumber == datum.today && isValid(datum.todayGap)"}],
      "layer": [
        {
          "mark": {
            "type": "rect",
            "x": {"expr": "layoutRight - max(length(todayLabel) * 10, length(datum.todayText) * 12) * 0.62 * layoutScale - 3"},
            "x2": {"expr": "layoutRight + 2"},
            "y": {"expr": "(datum.calloutLow ? layoutSparkBottom - 19 * layoutScale : layoutSparkTop + 5 * layoutScale) - 7 * layoutScale"},
            "y2": {"expr": "(datum.calloutLow ? layoutSparkBottom - 5 * layoutScale : layoutSparkTop + 19 * layoutScale) + 8 * layoutScale"},
            "cornerRadius": 2,
            "fill": {"expr": "cardColor"},
            "opacity": 0.85
          }
        },
        {
          "mark": {
            "type": "text",
            "text": {"expr": "todayLabel"},
            "x": {"expr": "layoutRight"},
            "y": {"expr": "datum.calloutLow ? layoutSparkBottom - 19 * layoutScale : layoutSparkTop + 5 * layoutScale"},
            "align": "right",
            "baseline": "middle",
            "fontSize": {"expr": "10 * layoutScale"},
            "fontWeight": 600,
            "fill": {"expr": "textMuted"}
          }
        },
        {
          "mark": {
            "type": "text",
            "x": {"expr": "layoutRight"},
            "y": {"expr": "datum.calloutLow ? layoutSparkBottom - 5 * layoutScale : layoutSparkTop + 19 * layoutScale"},
            "align": "right",
            "baseline": "middle",
            "fontSize": {"expr": "12 * layoutScale"},
            "fontWeight": 600
          },
          "encoding": {
            "text": {"field": "todayText", "type": "nominal"},
            "color": {"field": "todayColor", "type": "nominal", "scale": null, "legend": null}
          }
        }
      ]
    }
  ]
}
