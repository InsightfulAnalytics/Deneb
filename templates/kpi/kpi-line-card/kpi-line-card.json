      }
    },
    {
      "description": "Reporting month value",
      "transform": [{"filter": "datum.isRM"}],
      "mark": {
        "type": "text",
        "x": {"expr": "margin"},
        "y": {"expr": "valueBaseline"},
        "align": "left",
        "baseline": "alphabetic",
        "fontWeight": "bold",
        "fontSize": {"expr": "valueSize"},
        "limit": {"expr": "width - 2 * margin"}
      },
      "encoding": {
        "text": {"field": "valueText", "type": "nominal"},
        "color": {"field": "valueFill", "type": "nominal", "scale": null},
        "tooltip": [
          {"field": "monthText", "type": "nominal", "title": "Reporting month"},
          {"field": "valueTip", "type": "nominal", "title": "Value"},
          {"field": "targetTip", "type": "nominal", "title": "Target"},
          {"field": "gapTip", "type": "nominal", "title": "Gap to target"}
        ]
      }
    },
    {
      "description": "Three status lines, coloured by the reporting month's gap to target",
      "transform": [{"filter": "datum.isRM"}],
      "mark": {
        "type": "text",
        "x": {"expr": "margin"},
        "y": {"expr": "statusBaseline"},
        "align": "left",
        "baseline": "alphabetic",
        "fontSize": {"expr": "statusSize"},
        "lineHeight": {"expr": "statusLineHeight"},
        "limit": {"expr": "width - 2 * margin"}
      },
      "encoding": {
        "text": {"field": "statusLines", "type": "nominal"},
        "color": {"field": "statusColor", "type": "nominal", "scale": null}
      }
    },
    {
      "description": "Target line: one rule per run of months with the same target, so a changing target steps",
      "transform": [
        {"filter": "isValid(datum.tg)"},
        {"calculate": "datum.idx === 0 || datum.tg !== datum.prevTarget ? 1 : 0", "as": "runBreak"},
        {"window": [{"op": "sum", "field": "runBreak", "as": "runId"}], "sort": [{"field": "idx", "order": "ascending"}]},
        {
          "aggregate": [
            {"op": "min", "field": "idx", "as": "runStart"},
            {"op": "max", "field": "idx", "as": "runEnd"},
            {"op": "min", "field": "tg", "as": "runTarget"}
          ],
          "groupby": ["runId", "n"]
        },
        {"calculate": "max(datum.runStart - 0.5, -xPadding)", "as": "xFrom"},
        {"calculate": "min(datum.runEnd + 0.5, datum.n - 1 + xPadding)", "as": "xTo"}
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": {"expr": "targetLineWidth"},
        "strokeDash": {"expr": "targetLineDash"},
        "color": {"expr": "targetLineColor"}
      },
      "encoding": {
        "x": {
          "field": "xFrom",
          "type": "quantitative",
          "axis": null,
          "scale": {"zero": false, "nice": false, "range": [{"expr": "margin"}, {"expr": "width - margin"}]}
        },
        "x2": {"field": "xTo"},
        "y": {
          "field": "runTarget",
          "type": "quantitative",
          "axis": null,
          "scale": {"zero": false, "nice": false, "range": [{"expr": "plotBottom"}, {"expr": "plotTop"}]}
        }
      }
    },
    {
      "description": "Monthly line",
      "mark": {
        "type": "line",
        "strokeWidth": {"expr": "lineWidth"},
        "color": {"expr": "lineColor"},
        "strokeJoin": "round",
        "strokeCap": "round"
      },
      "encoding": {
        "x": {"field": "idx", "type": "quantitative"},
        "y": {"field": "v", "type": "quantitative"},
        "order": {"field": "idx", "type": "quantitative"}
      }
    },
    {
      "description": "Target label halo, keeps the label readable where the line crosses it",
      "transform": [{"filter": "datum.idx === 0 && isValid(datum.tg)"}],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "line-bottom",
        "lineHeight": {"expr": "1.6 * targetLabelSize"},
        "fontSize": {"expr": "targetLabelSize"},
        "fill": {"expr": "cardColor"},
        "stroke": {"expr": "cardColor"},
        "strokeWidth": {"expr": "0.25 * targetLabelSize"},
        "strokeJoin": "round",
        "limit": {"expr": "width - 2 * margin"}
      },
      "encoding": {
        "x": {"value": {"expr": "margin"}},
        "y": {"field": "tg", "type": "quantitative"},
        "text": {"field": "labelLines", "type": "nominal"}
      }
    },
    {
      "description": "Target label at the left end of the target line, above it unless the first month sits above target and there is room below",
      "transform": [{"filter": "datum.idx === 0 && isValid(datum.tg)"}],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "line-bottom",
        "lineHeight": {"expr": "1.6 * targetLabelSize"},
        "fontSize": {"expr": "targetLabelSize"},
        "fill": {"expr": "labelColor"},
        "limit": {"expr": "width - 2 * margin"}
      },
      "encoding": {
        "x": {"value": {"expr": "margin"}},
        "y": {"field": "tg", "type": "quantitative"},
        "text": {"field": "labelLines", "type": "nominal"}
      }
    },
    {
      "description": "Month markers, coloured by each month's value against its target",
      "transform": [{"filter": "isValid(datum.v)"}],
      "mark": {
        "type": "circle",
        "opacity": 1,
        "size": {"expr": "PI * markerRadius * markerRadius"}
      },
      "encoding": {
        "x": {"field": "idx", "type": "quantitative"},
        "y": {"field": "v", "type": "quantitative"},
        "color": {"field": "markerColor", "type": "nominal", "scale": null},
        "tooltip": [
          {"field": "monthText", "type": "nominal", "title": "Month"},
          {"field": "valueTip", "type": "nominal", "title": "Value"},
          {"field": "targetTip", "type": "nominal", "title": "Target"},
          {"field": "gapTip", "type": "nominal", "title": "Gap to target"}
        ]
      }
    },
    {
      "description": "Month labels, thinned when months are too close to label them all",
      "transform": [
        {"calculate": "max(1, ceil(labelSize * 3.6 / ((width - 2 * margin) / max(datum.n - 1 + 2 * xPadding, 0.001))))", "as": "labelEvery"},
        {"filter": "(datum.n - 1 - datum.idx) % datum.labelEvery === 0"}
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "alphabetic",
        "fontSize": {"expr": "labelSize"},
        "fill": {"expr": "labelColor"}
      },
      "encoding": {
        "x": {"field": "idx", "type": "quantitative"},
        "y": {"value": {"expr": "axisBaseline"}},
        "text": {"field": "monthText", "type": "nominal"}
      }
    },
    {
      "description": "Card border",
      "data": {"values": [{}]},
      "mark": {
        "type": "rect",
        "filled": false,
        "x": {"expr": "borderWidth / 2"},
        "y": {"expr": "borderWidth / 2"},
        "x2": {"expr": "width - borderWidth / 2"},
        "y2": {"expr": "height - borderWidth / 2"},
        "stroke": {"expr": "borderColor"},
        "strokeWidth": {"expr": "borderWidth"}
      }
    }
  ]
}
