    "information": {
      "name": "KPI Line Card",
      "description": "A whole KPI card in one visual: header band, the reporting month's value, three status lines coloured by its gap to target (MoM change, gap to target, reporting-year figure) and a monthly line with a target line and good/bad markers. Design after Gerard Duggan (dg-analysis.com).",
      "author": "Timothy Osborn, after Gerard Duggan",
      "uuid": "d9357d46-c576-4607-9e6c-2c3dc361ebbd",
      "generated": "2026-09-23T00:00:00.000Z",
      "previewImageBase64PNG": "data:image/png;base64,"
    },
    "dataset": [
      {
        "key": "__0__",
        "name": "Month",
        "description": "Month end date, one row per month. The line draws every month it receives.",
        "type": "dateTime",
        "kind": "column"
      },
      {
        "key": "__1__",
        "name": "Value",
        "description": "The month's value, for example net revenue or an on-time delivery rate.",
        "type": "numeric",
        "kind": "measure"
      },
      {
        "key": "__2__",
        "name": "Target",
        "description": "The month's target for Value.",
        "type": "numeric",
        "kind": "measure"
      },
      {
        "key": "__3__",
        "name": "Is Reporting Month",
        "description": "1 on the month the card reports on, else 0. With no 1 in the data the latest month is used.",
        "type": "numeric",
        "kind": "measure"
      }
    ],
    "interactivity": {
      "tooltip": true,
      "contextMenu": true,
      "selection": false,
      "highlight": false,
      "dataPointLimit": 50
    }
  },
  "config": {
    "autosize": {"type": "fit", "contains": "padding"},
    "view": {"stroke": "transparent"},
    "background": "transparent",
    "font": "Segoe UI"
  },
  "padding": 0,
  "params": [
    {"name": "title", "value": "REVENUE"},
    {"name": "headerColor", "expr": "pbiColor(0)"},
    {"name": "headerTextColor", "value": "#FFFFFF"},
    {"name": "cardColor", "value": "#FFFFFF"},
    {"name": "borderColor", "expr": "pbiColor(0, -0.25)"},
    {"name": "borderWidth", "value": 1},
    {"name": "valueFormat", "value": "$,.0f"},
    {"name": "valueColor", "expr": "pbiColor(0, -0.5)"},
    {"name": "valueColorByStatus", "value": false},
    {"name": "metricLabel", "value": "Rev"},
    {"name": "rmLabel", "value": "RM"},
    {"name": "ryLabel", "value": "RY"},
    {"name": "momLabel", "value": "MoM"},
    {"name": "momFormat", "value": "+.1%"},
    {"name": "arrowUp", "value": "▲"},
    {"name": "arrowDown", "value": "▼"},
    {"name": "arrowFlat", "value": "►"},
    {"name": "varianceUnit", "value": "absolute"},
    {"name": "deltaFormat", "value": "$,.2~f"},
    {"name": "valueDivisor", "value": 1000},
    {"name": "valueSuffix", "value": "K"},
    {"name": "ryFormat", "value": "$,.2~f"},
    {"name": "yearAggregate", "value": "sum"},
    {"name": "aboveText", "value": "above"},
    {"name": "belowText", "value": "below"},
    {"name": "onText", "value": "on"},
    {"name": "targetNoun", "value": "target rev"},
    {"name": "targetLabel", "value": "Target Rev"},
    {"name": "noDataText", "value": "n/a"},
    {"name": "higherIsBetter", "value": true},
    {"name": "dateFormat", "value": "%b %y"},
    {"name": "colorGood", "expr": "pbiColor('good')"},
    {"name": "colorBad", "expr": "pbiColor('bad')"},
    {"name": "colorNeutral", "expr": "pbiColor('neutral')"},
    {"name": "lineColor", "expr": "pbiColor(0, -0.5)"},
    {"name": "targetLineColor", "value": "#A19F9D"},
    {"name": "labelColor", "value": "#605E5C"},
    {"name": "xPadding", "value": 0.4},
    {"name": "unit", "expr": "clamp(min(width / 264, height / 235), 0.5, 4)"},
    {"name": "margin", "expr": "19 * unit"},
    {"name": "headerHeight", "expr": "33 * unit"},
    {"name": "titleSize", "expr": "14.5 * unit"},
    {"name": "valueSize", "expr": "35 * unit"},
    {"name": "statusSize", "expr": "11 * unit"},
    {"name": "statusLineHeight", "expr": "13.8 * unit"},
    {"name": "labelSize", "expr": "9.5 * unit"},
    {"name": "valueBaseline", "expr": "headerHeight + 39 * unit"},
    {"name": "statusBaseline", "expr": "valueBaseline + 31 * unit"},
    {"name": "plotTop", "expr": "statusBaseline + 2 * statusLineHeight + 17 * unit"},
    {"name": "plotBottom", "expr": "height - 30 * unit"},
    {"name": "axisBaseline", "expr": "height - 10 * unit"},
    {"name": "markerRadius", "expr": "4.6 * unit"},
    {"name": "lineWidth", "expr": "1.8 * unit"},
    {"name": "targetLineWidth", "expr": "2 * unit"},
    {"name": "targetLineDash", "expr": "[2 * unit, 1.7 * unit]"},
    {"name": "targetLabelSize", "expr": "10 * unit"}
  ],
  "data": {"name": "dataset"},
  "transform": [
    {"calculate": "time(datum['__0__'])", "as": "t"},
    {"filter": "isFinite(datum.t)"},
    {"calculate": "toNumber(datum['__1__'])", "as": "v"},
    {"calculate": "toNumber(datum['__2__'])", "as": "tg"},
    {"calculate": "toNumber(datum['__3__']) > 0 ? datum.t : null", "as": "flagT"},
    {
      "window": [
        {"op": "row_number", "as": "rowNumber"},
        {"op": "lag", "field": "v", "as": "prevV"},
        {"op": "lag", "field": "tg", "as": "prevTarget"}
      ],
      "sort": [{"field": "t", "order": "ascending"}]
    },
    {
      "joinaggregate": [
        {"op": "max", "field": "flagT", "as": "flaggedT"},
        {"op": "max", "field": "t", "as": "lastT"},
        {"op": "count", "as": "n"},
        {"op": "min", "field": "v", "as": "minV"},
        {"op": "max", "field": "v", "as": "maxV"},
        {"op": "min", "field": "tg", "as": "minTarget"},
        {"op": "max", "field": "tg", "as": "maxTarget"}
      ]
    },
    {"calculate": "datum.rowNumber - 1", "as": "idx"},
    {"calculate": "isValid(datum.flaggedT) ? datum.flaggedT : datum.lastT", "as": "rmT"},
    {"calculate": "datum.t === datum.rmT", "as": "isRM"},
    {"calculate": "datum.isRM ? datum.v : null", "as": "rmPart"},
    {"calculate": "datum.isRM ? datum.tg : null", "as": "rmTargetPart"},
    {"calculate": "datum.isRM ? datum.prevV : null", "as": "pmPart"},
    {"calculate": "isValid(datum.v) && year(datum.t) === year(datum.rmT) && datum.t <= datum.rmT ? datum.v : null", "as": "ryPart"},
    {
      "joinaggregate": [
        {"op": "max", "field": "rmPart", "as": "rmV"},
        {"op": "max", "field": "rmTargetPart", "as": "rmTg"},
        {"op": "max", "field": "pmPart", "as": "pmV"},
        {"op": "sum", "field": "ryPart", "as": "rySum"},
        {"op": "mean", "field": "ryPart", "as": "ryMean"}
      ]
    },
    {"calculate": "isValid(datum.rmV) && isValid(datum.rmTg) ? datum.rmV - datum.rmTg : null", "as": "gap"},
    {"calculate": "isValid(datum.gap) ? (higherIsBetter ? 1 : -1) * datum.gap : 0", "as": "goodness"},
    {"calculate": "datum.goodness > 0 ? colorGood : datum.goodness < 0 ? colorBad : colorNeutral", "as": "statusColor"},
    {"calculate": "valueColorByStatus ? datum.statusColor : valueColor", "as": "valueFill"},
    {"calculate": "!isValid(datum.v) || !isValid(datum.tg) ? colorNeutral : (higherIsBetter ? datum.v >= datum.tg : datum.v <= datum.tg) ? colorGood : colorBad", "as": "markerColor"},
    {"calculate": "isValid(datum.rmV) && isValid(datum.pmV) && datum.pmV !== 0 ? (datum.rmV - datum.pmV) / abs(datum.pmV) : null", "as": "mom"},
    {"calculate": "!isValid(datum.gap) ? null : varianceUnit === 'percent' ? datum.gap / abs(datum.rmTg) : varianceUnit === 'points' ? datum.gap : datum.gap / valueDivisor", "as": "gapShown"},
    {"calculate": "yearAggregate === 'mean' ? datum.ryMean : datum.rySum", "as": "ry"},
    {"calculate": "isValid(datum.rmV) ? format(datum.rmV, valueFormat) : noDataText", "as": "valueText"},
    {"calculate": "momLabel + ' ' + (!isValid(datum.mom) ? noDataText : (datum.mom > 0 ? arrowUp : datum.mom < 0 ? arrowDown : arrowFlat) + ' at ' + (datum.mom < 0 ? '-' : indexof(momFormat, '+') >= 0 ? '+' : '') + format(abs(datum.mom), replace(momFormat, '+', '')))", "as": "momText"},
    {"calculate": "metricLabel + ' ' + rmLabel + ': ' + (!isValid(datum.gapShown) || !isFinite(datum.gapShown) ? noDataText : (datum.gapShown < 0 ? '-' : indexof(deltaFormat, '+') >= 0 ? '+' : '') + format(abs(datum.gapShown), replace(deltaFormat, '+', '')) + (varianceUnit === 'absolute' ? valueSuffix : '') + ' ' + (datum.gap > 0 ? aboveText : datum.gap < 0 ? belowText : onText) + ' ' + targetNoun)", "as": "gapText"},
    {"calculate": "metricLabel + ' ' + ryLabel + ': ' + (!isValid(datum.ry) || !isFinite(datum.ry) ? noDataText : (datum.ry < 0 ? '-' : indexof(ryFormat, '+') >= 0 ? '+' : '') + format(abs(datum.ry) / valueDivisor, replace(ryFormat, '+', '')) + valueSuffix)", "as": "ryText"},
    {"calculate": "[datum.momText, datum.gapText, datum.ryText]", "as": "statusLines"},
    {"calculate": "timeFormat(datum.t, dateFormat)", "as": "monthText"},
    {"calculate": "isValid(datum.v) ? format(datum.v, valueFormat) : noDataText", "as": "valueTip"},
    {"calculate": "isValid(datum.tg) ? format(datum.tg, valueFormat) : noDataText", "as": "targetTip"},
    {"calculate": "isValid(datum.v) && isValid(datum.tg) ? (datum.v < datum.tg ? '-' : '+') + format(abs(datum.v - datum.tg), valueFormat) : noDataText", "as": "gapTip"},
    {"calculate": "isValid(datum.minTarget) && isValid(datum.minV) ? min(datum.minV, datum.minTarget) : isValid(datum.minTarget) ? datum.minTarget : datum.minV", "as": "domainLo"},
    {"calculate": "isValid(datum.maxTarget) && isValid(datum.maxV) ? max(datum.maxV, datum.maxTarget) : isValid(datum.maxTarget) ? datum.maxTarget : datum.maxV", "as": "domainHi"},
    {"calculate": "(datum.domainHi > datum.domainLo ? (datum.tg - datum.domainLo) / (datum.domainHi - datum.domainLo) : 0.5) * (plotBottom - plotTop)", "as": "roomBelowTarget"},
    {"calculate": "datum.v > datum.tg && datum.roomBelowTarget >= 6 * unit ? ['', targetLabel] : [targetLabel, '']", "as": "labelLines"}
  ],
  "layer": [
    {
      "description": "Card background",
      "data": {"values": [{}]},
      "mark": {
        "type": "rect",
        "x": 0,
        "y": 0,
        "x2": {"expr": "width"},
        "y2": {"expr": "height"},
        "fill": {"expr": "cardColor"}
      }
    },
    {
      "description": "Header band",
      "data": {"values": [{}]},
      "mark": {
        "type": "rect",
        "x": 0,
        "y": 0,
        "x2": {"expr": "width"},
