{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "usermeta": {
    "deneb": {
      "build": "1.9.1.0",
      "metaVersion": 1,
      "provider": "vegaLite",
      "providerVersion": "6.4.1"
    },
    "information": {
      "name": "Half-Donut Gauge",
      "description": "A half-donut gauge for one ratio: the ring fills from 0% to 100% with the score, a tick marks the target, and the score sits large in the centre. Optionally colours the fill good or bad against the target. Design by Timothy Osborn.",
      "author": "Timothy Osborn",
      "uuid": "34c24562-181e-46c4-9cbb-acf5f1ec3bf0",
      "generated": "2026-09-23T00:00:00.000Z",
      "previewImageBase64PNG": "data:image/png;base64,"
    },
    "dataset": [
      {
        "key": "__0__",
        "name": "Score",
        "description": "The value to show, as a ratio from 0 to 1 (0.72 fills 72% of the ring). Values outside 0-1 are drawn at the nearest end and labelled with the real value.",
        "type": "numeric",
        "kind": "measure"
      },
      {
        "key": "__1__",
        "name": "Target",
        "description": "The target, as a ratio from 0 to 1. Drawn as a tick across the ring with its value beside it. Leave it blank to hide the tick.",
        "type": "numeric",
        "kind": "measure"
      }
    ],
    "interactivity": {
      "tooltip": true,
      "contextMenu": true,
      "selection": false,
      "highlight": false,
      "dataPointLimit": 50
    }
  },
  "config": {
    "autosize": {"type": "fit", "contains": "padding"},
    "view": {"stroke": "transparent"},
    "background": "transparent",
    "font": "Segoe UI"
  },
  "params": [
    {"name": "valueFormat", "value": ".0%"},
    {"name": "startLabel", "value": "0%"},
    {"name": "endLabel", "value": "100%"},
    {"name": "targetPrefix", "value": ""},
    {"name": "colourByTarget", "value": false},
    {"name": "colorFill", "expr": "pbiColor(0)"},
    {"name": "colorGood", "expr": "pbiColor('good')"},
    {"name": "colorBad", "expr": "pbiColor('bad')"},
    {"name": "colorTrack", "value": "#E1DFDD"},
    {"name": "colorTarget", "value": "#252423"},
    {"name": "colorScoreText", "value": "#252423"},
    {"name": "colorLabel", "value": "#605E5C"},
    {"name": "ringFillOpacity", "value": 0.6},
    {"name": "ringStrokeWidth", "value": 3},
    {"name": "ringInnerRatio", "value": 0.65},
    {"name": "targetTickOverhang", "value": 6},
    {"name": "targetTickWidth", "value": 3},
    {"name": "labelFontSize", "value": 13},
    {"name": "scoreFontSize", "expr": "ringInner * 0.6"},
    {"name": "scoreFontWeight", "value": "normal"},
    {"name": "labelGap", "value": 6},
    {"name": "sideRoom", "expr": "targetTickOverhang + labelGap + labelFontSize * 0.62 * (length(targetPrefix) + length(format(1, valueFormat)))"},
    {"name": "topRoom", "expr": "targetTickOverhang + labelGap + labelFontSize * 1.3"},
    {"name": "bottomRoom", "expr": "labelGap + labelFontSize * 1.3"},
    {"name": "ringOuter", "expr": "max(8, min(width / 2 - sideRoom, height - topRoom - bottomRoom))"},
    {"name": "ringInner", "expr": "ringOuter * ringInnerRatio"},
    {"name": "ringMiddle", "expr": "(ringOuter + ringInner) / 2"},
    {"name": "centreX", "expr": "width / 2"},
    {"name": "centreY", "expr": "max(0, (height - topRoom - ringOuter - bottomRoom) / 2) + topRoom + ringOuter"},
    {"name": "targetLabelRadius", "expr": "ringOuter + targetTickOverhang + labelGap"},
    {"name": "endLabelLimit", "expr": "max(24, 2 * min(width / 2 - ringMiddle, ringMiddle))"}
  ],
  "data": {"name": "dataset"},
  "layer": [
    {
      "description": "Track and end labels. They read a one-row inline table, so they draw even when no rows arrive.",
      "data": {"values": [{}]},
      "layer": [
        {
          "mark": {
            "type": "arc",
            "x": {"expr": "centreX"},
            "y": {"expr": "centreY"},
            "radius": {"expr": "ringOuter"},
            "radius2": {"expr": "ringInner"},
            "theta": {"expr": "-PI / 2"},
            "theta2": {"expr": "PI / 2"},
            "fill": {"expr": "colorTrack"},
            "fillOpacity": {"expr": "ringFillOpacity"},
            "stroke": {"expr": "colorTrack"},
            "strokeWidth": {"expr": "ringStrokeWidth"}
          }
        },
        {
          "mark": {
            "type": "text",
            "x": {"expr": "centreX - ringMiddle"},
            "y": {"expr": "centreY + labelGap"},
            "align": "center",
            "baseline": "top",
            "text": {"expr": "startLabel"},
            "fontSize": {"expr": "labelFontSize"},
            "fill": {"expr": "colorLabel"},
            "limit": {"expr": "endLabelLimit"}
          }
        },
        {
          "mark": {
            "type": "text",
            "x": {"expr": "centreX + ringMiddle"},
            "y": {"expr": "centreY + labelGap"},
            "align": "center",
            "baseline": "top",
            "text": {"expr": "endLabel"},
            "fontSize": {"expr": "labelFontSize"},
            "fill": {"expr": "colorLabel"},
            "limit": {"expr": "endLabelLimit"}
          }
        }
      ]
    },
    {
      "description": "Score, target tick and labels. The aggregate reduces the rows to exactly one, so extra rows never draw twice, and zero rows draw nothing here.",
      "transform": [
        {
          "aggregate": [
            {"op": "mean", "field": "__0__", "as": "scoreRaw"},
            {"op": "mean", "field": "__1__", "as": "targetRaw"}
          ]
        },
        {"calculate": "isValid(datum.scoreRaw) ? clamp(datum.scoreRaw, 0, 1) : null", "as": "scoreDraw"},
        {"calculate": "isValid(datum.targetRaw) ? clamp(datum.targetRaw, 0, 1) : null", "as": "targetDraw"},
        {"calculate": "isValid(datum.scoreDraw) ? -PI / 2 + PI * datum.scoreDraw : null", "as": "scoreTheta"},
        {"calculate": "isValid(datum.targetDraw) ? -PI / 2 + PI * datum.targetDraw : null", "as": "targetTheta"},
        {"calculate": "isValid(datum.scoreRaw) ? format(datum.scoreRaw, valueFormat) : ''", "as": "scoreText"},
        {"calculate": "isValid(datum.targetRaw) ? format(datum.targetRaw, valueFormat) : ''", "as": "targetText"},
        {"calculate": "targetPrefix + datum.targetText", "as": "targetLabel"},
        {"calculate": "labelFontSize * 0.31 * length(datum.targetLabel)", "as": "targetLabelHalfWidth"},
        {"calculate": "colourByTarget && isValid(datum.targetRaw) ? (datum.scoreRaw >= datum.targetRaw ? colorGood : colorBad) : colorFill", "as": "fillColour"},
        {"calculate": "datum.scoreText", "as": "__0__"},
        {"calculate": "datum.targetText", "as": "__1__"}
      ],
      "layer": [
        {
          "description": "Score arc, from 0% to the clamped score.",
          "transform": [{"filter": "datum.scoreDraw > 0"}],
          "mark": {
            "type": "arc",
            "x": {"expr": "centreX"},
            "y": {"expr": "centreY"},
            "radius": {"expr": "ringOuter"},
            "radius2": {"expr": "ringInner"},
            "theta": {"expr": "-PI / 2"},
            "theta2": {"expr": "datum.scoreTheta"},
            "fillOpacity": {"expr": "ringFillOpacity"},
            "strokeWidth": {"expr": "ringStrokeWidth"}
          },
          "encoding": {
            "fill": {"field": "fillColour", "type": "nominal", "scale": null},
            "stroke": {"field": "fillColour", "type": "nominal", "scale": null},
            "tooltip": [
              {"field": "__0__", "type": "nominal"},
              {"field": "__1__", "type": "nominal"}
            ]
          }
        },
        {
          "description": "Target tick, crossing the ring and overhanging it on both sides.",
          "transform": [{"filter": "isValid(datum.targetDraw)"}],
          "mark": {
            "type": "rule",
            "stroke": {"expr": "colorTarget"},
            "strokeWidth": {"expr": "targetTickWidth"},
            "strokeCap": "butt"
          },
          "encoding": {
            "x": {"value": {"expr": "centreX + sin(datum.targetTheta) * (ringInner - targetTickOverhang)"}},
            "y": {"value": {"expr": "centreY - cos(datum.targetTheta) * (ringInner - targetTickOverhang)"}},
            "x2": {"value": {"expr": "centreX + sin(datum.targetTheta) * (ringOuter + targetTickOverhang)"}},
            "y2": {"value": {"expr": "centreY - cos(datum.targetTheta) * (ringOuter + targetTickOverhang)"}},
            "tooltip": [
              {"field": "__0__", "type": "nominal"},
              {"field": "__1__", "type": "nominal"}
            ]
          }
        },
        {
          "description": "Target label, placed radially just beyond the tick so it clears the ring at any angle.",
          "transform": [{"filter": "isValid(datum.targetDraw)"}],
          "mark": {
            "type": "text",
            "x": {"expr": "centreX + sin(datum.targetTheta) * (targetLabelRadius + abs(sin(datum.targetTheta)) * datum.targetLabelHalfWidth + abs(cos(datum.targetTheta)) * labelFontSize * 0.6)"},
            "y": {"expr": "centreY - cos(datum.targetTheta) * (targetLabelRadius + abs(sin(datum.targetTheta)) * datum.targetLabelHalfWidth + abs(cos(datum.targetTheta)) * labelFontSize * 0.6)"},
            "align": "center",
            "baseline": "middle",
            "fontSize": {"expr": "labelFontSize"},
            "fill": {"expr": "colorLabel"},
            "limit": {"expr": "max(20, 2 * datum.targetLabelHalfWidth + sideRoom)"}
          },
          "encoding": {
            "text": {"field": "targetLabel", "type": "nominal"}
          }
        },
        {
          "description": "Score label, centred in the hole and sitting on the ring's flat edge. It shows the real value, even when the arc is clamped, and shrinks when a long value would not fit the hole.",
          "transform": [{"filter": "isValid(datum.scoreRaw)"}],
          "mark": {
            "type": "text",
            "x": {"expr": "centreX"},
            "y": {"expr": "centreY"},
            "align": "center",
            "baseline": "alphabetic",
            "fontSize": {"expr": "min(scoreFontSize, ringInner * 1.7 / (0.65 * max(1, length(datum.scoreText))))"},
            "fontWeight": {"expr": "scoreFontWeight"},
            "fill": {"expr": "colorScoreText"},
            "limit": {"expr": "2 * ringOuter"}
          },
          "encoding": {
            "text": {"field": "scoreText", "type": "nominal"},
            "tooltip": [
              {"field": "__0__", "type": "nominal"},
              {"field": "__1__", "type": "nominal"}
            ]
          }
        }
      ]
    }
  ]
}
