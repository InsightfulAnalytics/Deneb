{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "usermeta": {
    "deneb": {
      "build": "1.9.1.0",
      "metaVersion": 1,
      "provider": "vegaLite",
      "providerVersion": "6.4.1"
    },
    "information": {
      "name": "Bullet with Prior Period",
      "description": "One bullet per row: an actual bar coloured by whether it beats target, a lighter previous-period band coloured by whether that period beat target, and a target tick, each row on its own axis. Higher or lower can be better per row. Design after Gerard Duggan (dg-analysis.com).",
      "author": "Timothy Osborn, after Gerard Duggan",
      "uuid": "3a3549dc-99ce-4b53-95c6-81b4dc78c4c7",
      "generated": "2026-09-23T00:00:00.000Z",
      "previewImageBase64PNG": "data:image/png;base64,"
    },
    "dataset": [
      {
        "key": "__0__",
        "name": "Metric",
        "description": "Row label, one row per metric, e.g. RM Revenue.",
        "type": "text",
        "kind": "column"
      },
      {
        "key": "__1__",
        "name": "Sort Order",
        "description": "Row order, smallest at the top.",
        "type": "numeric",
        "kind": "column"
      },
      {
        "key": "__2__",
        "name": "Actual",
        "description": "Current period value: the thick bar.",
        "type": "numeric",
        "kind": "measure"
      },
      {
        "key": "__3__",
        "name": "Target",
        "description": "Target for the current period: the dark tick.",
        "type": "numeric",
        "kind": "measure"
      },
      {
        "key": "__4__",
        "name": "Previous",
        "description": "Previous period value: the light band behind the bar.",
        "type": "numeric",
        "kind": "measure"
      },
      {
        "key": "__5__",
        "name": "Higher Is Better",
        "description": "1 when a value above target is good, 0 when a value below target is good.",
        "type": "numeric",
        "kind": "measure"
      }
    ],
    "interactivity": {
      "tooltip": true,
      "contextMenu": true,
      "selection": false,
      "highlight": false,
      "dataPointLimit": 50
    }
  },
  "config": {
    "autosize": {"type": "fit", "contains": "padding"},
    "view": {"stroke": "transparent"},
    "background": "transparent",
    "font": "Segoe UI"
  },
  "params": [
    {"name": "valueFormat", "value": ".1~%"},
    {"name": "independentScales", "value": true},
    {"name": "axisMax", "value": null},
    {"name": "headroom", "value": 0.1},
    {"name": "tickCount", "value": 3},
    {"name": "colorGood", "expr": "pbiColor('good')"},
    {"name": "colorBad", "expr": "pbiColor('bad')"},
    {"name": "colorNeutral", "expr": "pbiColor('neutral')"},
    {"name": "colorGoodTint", "expr": "pbiColor('good', 0.6)"},
    {"name": "colorBadTint", "expr": "pbiColor('bad', 0.6)"},
    {"name": "colorNeutralTint", "expr": "pbiColor('neutral', 0.6)"},
    {"name": "trackColor", "value": "#EEF0F3"},
    {"name": "targetColor", "value": "#252423"},
    {"name": "trackThickness", "value": 0.48},
    {"name": "previousBandThickness", "value": 0.66},
    {"name": "actualBarThickness", "value": 0.4},
    {"name": "targetTickLength", "value": 0.7},
    {"name": "targetTickWidth", "value": 3},
    {"name": "rowLabelFontSize", "value": 12},
    {"name": "rowLabelColor", "value": "#252423"},
    {"name": "rowLabelLimit", "value": 140},
    {"name": "axisFontSize", "value": 9},
    {"name": "axisLabelColor", "value": "#605E5C"},
    {"name": "axisTickColor", "value": "#A19F9D"}
  ],
  "data": {"name": "dataset"},
  "transform": [
    {"calculate": "isValid(datum['__0__']) ? '' + datum['__0__'] : '(blank)'", "as": "label"},
    {"calculate": "toNumber(datum['__1__'])", "as": "sortKey"},
    {"calculate": "isValid(datum['__2__']) ? toNumber(datum['__2__']) : null", "as": "actual"},
    {"calculate": "isValid(datum['__3__']) ? toNumber(datum['__3__']) : null", "as": "target"},
    {"calculate": "isValid(datum['__4__']) ? toNumber(datum['__4__']) : null", "as": "previous"},
    {"calculate": "isValid(datum['__5__']) ? toNumber(datum['__5__']) !== 0 : true", "as": "higherIsBetter"},
    {"calculate": "!isValid(datum.actual) || !isValid(datum.target) ? 'none' : (datum.higherIsBetter ? datum.actual >= datum.target : datum.actual <= datum.target) ? 'good' : 'bad'", "as": "status"},
    {"calculate": "!isValid(datum.previous) || !isValid(datum.target) ? 'none' : (datum.higherIsBetter ? datum.previous >= datum.target : datum.previous <= datum.target) ? 'good' : 'bad'", "as": "previousStatus"},
    {"calculate": "datum.status === 'good' ? colorGood : datum.status === 'bad' ? colorBad : colorNeutral", "as": "actualColor"},
    {"calculate": "datum.previousStatus === 'good' ? colorGoodTint : datum.previousStatus === 'bad' ? colorBadTint : colorNeutralTint", "as": "previousColor"},
    {"calculate": "max(0, isValid(datum.actual) ? datum.actual : 0, isValid(datum.target) ? datum.target : 0, isValid(datum.previous) ? datum.previous : 0)", "as": "rowMax"},
    {"calculate": "min(0, isValid(datum.actual) ? datum.actual : 0, isValid(datum.target) ? datum.target : 0, isValid(datum.previous) ? datum.previous : 0)", "as": "rowMin"},
    {"joinaggregate": [{"op": "max", "field": "rowMax", "as": "allMax"}, {"op": "min", "field": "rowMin", "as": "allMin"}]},
    {"calculate": "(independentScales ? datum.rowMin : datum.allMin) * (1 + headroom)", "as": "lo"},
    {"calculate": "isValid(axisMax) ? axisMax : (independentScales ? datum.rowMax : datum.allMax) * (1 + headroom)", "as": "hi"},
    {"calculate": "datum.hi > datum.lo ? datum.hi - datum.lo : 1", "as": "span"},
    {"calculate": "(0 - datum.lo) / datum.span", "as": "xZero"},
    {"calculate": "(datum.actual - datum.lo) / datum.span", "as": "xActual"},
    {"calculate": "(datum.target - datum.lo) / datum.span", "as": "xTarget"},
    {"calculate": "(datum.previous - datum.lo) / datum.span", "as": "xPrevious"},
    {"calculate": "isValid(datum.actual) ? format(datum.actual, valueFormat) : '(blank)'", "as": "actualText"},
    {"calculate": "isValid(datum.target) ? format(datum.target, valueFormat) : '(blank)'", "as": "targetText"},
    {"calculate": "isValid(datum.previous) ? format(datum.previous, valueFormat) : '(blank)'", "as": "previousText"},
    {"calculate": "isValid(datum.actual) && isValid(datum.target) ? (datum.actual > datum.target ? '+' : '') + format(datum.actual - datum.target, valueFormat) : '(blank)'", "as": "varianceText"},
    {"calculate": "datum.status === 'good' ? 'Better than target' : datum.status === 'bad' ? 'Worse than target' : 'No target'", "as": "statusText"}
  ],
  "encoding": {
    "y": {
      "field": "label",
      "type": "nominal",
      "sort": {"field": "sortKey", "op": "min", "order": "ascending"},
      "scale": {"paddingInner": 0, "paddingOuter": 0},
      "title": null,
      "axis": {
        "domain": false,
        "ticks": false,
        "grid": false,
        "labelPadding": 10,
        "labelFontSize": {"expr": "rowLabelFontSize"},
        "labelColor": {"expr": "rowLabelColor"},
        "labelLimit": {"expr": "rowLabelLimit"}
      }
    }
  },
  "layer": [
    {
      "encoding": {
        "tooltip": [
          {"field": "label", "type": "nominal", "title": "Metric"},
          {"field": "actualText", "type": "nominal", "title": "Actual"},
          {"field": "targetText", "type": "nominal", "title": "Target"},
          {"field": "previousText", "type": "nominal", "title": "Previous"},
          {"field": "varianceText", "type": "nominal", "title": "Vs target"},
          {"field": "statusText", "type": "nominal", "title": "Status"}
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "bar",
            "color": {"expr": "trackColor"},
            "height": {"expr": "bandwidth('y') * trackThickness"}
          },
          "encoding": {
            "x": {
              "datum": 0,
              "type": "quantitative",
              "scale": {"domain": [0, 1], "nice": false, "zero": false, "clamp": true},
              "axis": null
            },
            "x2": {"datum": 1}
          }
        },
        {
          "transform": [{"filter": "isValid(datum.previous)"}],
          "mark": {
            "type": "bar",
            "height": {"expr": "bandwidth('y') * trackThickness * previousBandThickness"}
          },
          "encoding": {
            "x": {"field": "xZero", "type": "quantitative", "axis": null},
            "x2": {"field": "xPrevious"},
            "color": {"field": "previousColor", "type": "nominal", "scale": null}
          }
        },
        {
          "transform": [{"filter": "isValid(datum.actual)"}],
          "mark": {
            "type": "bar",
            "height": {"expr": "bandwidth('y') * trackThickness * actualBarThickness"}
          },
          "encoding": {
            "x": {"field": "xZero", "type": "quantitative", "axis": null},
            "x2": {"field": "xActual"},
            "color": {"field": "actualColor", "type": "nominal", "scale": null}
          }
        },
        {
          "transform": [{"filter": "isValid(datum.target)"}],
          "mark": {
            "type": "tick",
            "color": {"expr": "targetColor"},
            "opacity": 1,
            "thickness": {"expr": "targetTickWidth"},
            "size": {"expr": "bandwidth('y') * trackThickness * targetTickLength"}
          },
          "encoding": {
            "x": {"field": "xTarget", "type": "quantitative", "axis": null}
          }
        }
      ]
    },
    {
      "transform": [
        {"calculate": "datum.span / max(1, tickCount)", "as": "tickRaw"},
        {"calculate": "pow(10, floor(log(datum.tickRaw) / LN10))", "as": "tickMagnitude"},
        {"calculate": "datum.tickRaw / datum.tickMagnitude", "as": "tickError"},
        {"calculate": "(datum.tickError >= sqrt(50) ? 10 : datum.tickError >= sqrt(10) ? 5 : datum.tickError >= sqrt(2) ? 2 : 1) * datum.tickMagnitude", "as": "tickStep"},
        {"calculate": "sequence(ceil(datum.lo / datum.tickStep - 1e-9), floor((datum.lo + datum.span) / datum.tickStep + 1e-9) + 1)", "as": "tickIndex"},
        {"flatten": ["tickIndex"]},
        {"filter": "datum.hi > datum.lo || datum.tickIndex === 0"},
        {"calculate": "datum.tickIndex * datum.tickStep + 0", "as": "tickValue"},
        {"calculate": "(datum.tickValue - datum.lo) / datum.span", "as": "xTick"},
        {"calculate": "format(datum.tickValue, valueFormat)", "as": "tickText"},
        {"calculate": "length(datum.tickText)", "as": "tickTextLength"},
        {"joinaggregate": [{"op": "max", "field": "tickTextLength", "as": "tickTextLongest"}], "groupby": ["label"]}
      ],
      "layer": [
        {
          "mark": {
            "type": "tick",
            "color": {"expr": "axisTickColor"},
            "opacity": 1,
            "thickness": 1,
            "size": 4,
            "yOffset": {"expr": "bandwidth('y') * trackThickness / 2 + 2"}
          },
          "encoding": {
            "x": {"field": "xTick", "type": "quantitative", "axis": null}
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "center",
            "baseline": "top",
            "color": {"expr": "axisLabelColor"},
            "fontSize": {"expr": "axisFontSize"},
            "yOffset": {"expr": "bandwidth('y') * trackThickness / 2 + 6"}
          },
          "encoding": {
            "x": {"field": "xTick", "type": "quantitative", "axis": null},
            "text": {"field": "tickText", "type": "nominal"},
            "opacity": {
              "condition": {
                "test": "datum.tickIndex % max(1, ceil((datum.tickTextLongest * axisFontSize * 0.6 + 6) / max(1, datum.tickStep / datum.span * range('x')[1]))) === 0",
                "value": 1
              },
              "value": 0
            }
          }
        }
      ]
    }
  ]
}
