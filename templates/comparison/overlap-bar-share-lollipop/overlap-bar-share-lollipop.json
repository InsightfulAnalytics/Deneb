    "information": {
      "name": "Overlapping Bars with Share Lollipop",
      "description": "For each category, a dark current bar sits in front of a grey total bar, and a lollipop on the right shows current as a share of total. Built for top-N lists such as top customers or products. Design after Gerard Duggan (dg-analysis.com).",
      "author": "Timothy Osborn, after Gerard Duggan",
      "uuid": "4ada3fcc-220a-465e-9204-bb186117114d",
      "generated": "2026-09-23T00:00:00.000Z",
      "previewImageBase64PNG": "data:image/png;base64,"
    },
    "dataset": [
      {
        "key": "__0__",
        "name": "Category",
        "description": "One row per category, for example customer or product. Keep it to a short top-N list; long names wrap onto two lines.",
        "type": "text",
        "kind": "column"
      },
      {
        "key": "__1__",
        "name": "Current",
        "description": "The current value, for example reporting month revenue. Drawn as the dark front bar and used as the top of the share.",
        "type": "numeric",
        "kind": "measure"
      },
      {
        "key": "__2__",
        "name": "Total",
        "description": "The total the current value is part of, for example reporting year revenue. Drawn as the grey back bar; the share is Current / Total.",
        "type": "numeric",
        "kind": "measure"
      }
    ],
    "interactivity": {
      "tooltip": true,
      "contextMenu": true,
      "selection": false,
      "highlight": false,
      "dataPointLimit": 50
    }
  },
  "config": {
