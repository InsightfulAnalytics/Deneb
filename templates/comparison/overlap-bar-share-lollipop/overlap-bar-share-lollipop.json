  },
  "data": {"name": "dataset"},
  "transform": [
    {"calculate": "isValid(datum['__0__']) ? datum['__0__'] + '' : ''", "as": "catText"},
    {"calculate": "isValid(datum['__1__']) ? max(0, datum['__1__']) : 0", "as": "valCurrent"},
    {"calculate": "isValid(datum['__2__']) ? max(0, datum['__2__']) : 0", "as": "valTotal"},
    {"calculate": "isValid(datum['__1__']) && isValid(datum['__2__']) && datum['__2__'] != 0 ? datum['__1__'] / datum['__2__'] : null", "as": "share"},
    {"calculate": "max(datum.valCurrent, datum.valTotal)", "as": "valMax"},
    {"joinaggregate": [
      {"op": "max", "field": "valMax", "as": "scaleMax"},
      {"op": "max", "field": "share", "as": "shareMaxData"}
    ]},
    {"calculate": "shareAxisMax > 0 ? shareAxisMax : (datum.shareMaxData > 0 ? datum.shareMaxData : 1)", "as": "shareMax"},
    {"calculate": "isValid(datum['__1__']) ? format(datum['__1__'] / valueDivisor, valueFormat) + valueSuffix : ''", "as": "labelCurrent"},
    {"calculate": "isValid(datum['__2__']) ? format(datum['__2__'] / valueDivisor, valueFormat) + valueSuffix : ''", "as": "labelTotal"},
    {"calculate": "isValid(datum.share) ? format(datum.share, shareFormat) : ''", "as": "labelShare"},
    {"calculate": "length(datum.labelShare)", "as": "labelShareChars"},
    {"joinaggregate": [{"op": "max", "field": "labelShareChars", "as": "labelShareCharsMax"}]},
    {"calculate": "sqrt(lollipopHeadSize / PI) + labelGap + 4 + datum.labelShareCharsMax * shareFontSize * labelCharWidth", "as": "shareLabelSpace"},
    {"calculate": "max(0.1, 1 - datum.shareLabelSpace / max(width, 1) - lollipopLength - lollipopGap)", "as": "barAreaEnd"},
    {"calculate": "datum.scaleMax > 0 ? datum.valTotal / datum.scaleMax * datum.barAreaEnd : 0", "as": "xTotal"},
    {"calculate": "datum.scaleMax > 0 ? datum.valCurrent / datum.scaleMax * datum.barAreaEnd : 0", "as": "xCurrent"},
    {"calculate": "datum.barAreaEnd + lollipopGap", "as": "xStemStart"},
    {"calculate": "datum.xStemStart + (isValid(datum.share) ? clamp(datum.share / datum.shareMax, 0, 1) : 0) * lollipopLength", "as": "xStemEnd"},
    {"calculate": "length(datum.labelTotal) * labelFontSize * labelCharWidth + 2 * labelGap", "as": "labelTotalPx"},
    {"calculate": "length(datum.labelCurrent) * labelFontSize * labelCharWidth + 2 * labelGap", "as": "labelCurrentPx"},
    {"calculate": "datum.xTotal * width >= datum.labelTotalPx", "as": "labelTotalInside"},
    {"calculate": "datum.labelTotalInside || (datum.xStemStart - datum.xTotal) * width >= datum.labelTotalPx", "as": "labelTotalShown"},
    {"calculate": "datum.xCurrent * width >= datum.labelCurrentPx", "as": "labelCurrentInside"},
    {"calculate": "datum.labelCurrentInside || (datum.xStemStart - datum.xCurrent) * width >= datum.labelCurrentPx", "as": "labelCurrentShown"},
    {"calculate": "isValid(datum['__1__']) ? format(datum['__1__'], tooltipValueFormat) : ''", "as": "tipCurrent"},
    {"calculate": "isValid(datum['__2__']) ? format(datum['__2__'], tooltipValueFormat) : ''", "as": "tipTotal"},
    {"calculate": "(sortDescending ? -1 : 1) * (sortBy == 'total' ? datum.valTotal : sortBy == 'share' ? (isValid(datum.share) ? datum.share : 0) : datum.valCurrent)", "as": "sortKey"},
    {"calculate": "floor(length(datum.catText) / 2)", "as": "catMid"},
    {"calculate": "lastindexof(datum.catText, ' ', datum.catMid)", "as": "catSpaceBefore"},
    {"calculate": "indexof(datum.catText, ' ', datum.catMid)", "as": "catSpaceAfter"},
    {"calculate": "datum.catSpaceBefore < 0 ? datum.catSpaceAfter : datum.catSpaceAfter < 0 ? datum.catSpaceBefore : (datum.catMid - datum.catSpaceBefore <= datum.catSpaceAfter - datum.catMid ? datum.catSpaceBefore : datum.catSpaceAfter)", "as": "catCut"},
    {"calculate": "length(datum.catText) > categoryWrapChars && datum.catCut > 0 ? [substring(datum.catText, 0, datum.catCut), substring(datum.catText, datum.catCut + 1)] : datum.catText", "as": "catLines"}
  ],
  "encoding": {
    "y": {
      "field": "__0__",
      "type": "nominal",
      "sort": {"field": "sortKey", "op": "min", "order": "ascending"},
      "scale": {"paddingInner": 0, "paddingOuter": 0},
      "axis": null
    },
    "tooltip": [
      {"field": "__0__", "type": "nominal", "title": "__0__"},
      {"field": "tipCurrent", "type": "nominal", "title": "__1__"},
      {"field": "tipTotal", "type": "nominal", "title": "__2__"},
      {"field": "labelShare", "type": "nominal", "title": "Share of __2__"}
    ]
  },
  "layer": [
    {
      "transform": [{"filter": "datum.xTotal > 0"}],
      "mark": {
        "type": "bar",
        "fill": {"expr": "totalBarColor"},
