    {"name": "currentBarHeight", "value": 0.34},
    {"name": "currentBarOffset", "value": 0.13},
    {"name": "lollipopGap", "value": 0.07},
    {"name": "lollipopLength", "value": 0.18},
    {"name": "lollipopOffset", "value": 0},
    {"name": "lollipopStemWidth", "value": 3},
    {"name": "lollipopHeadSize", "value": 160},
    {"name": "shareAxisMax", "value": 0}
  ],
