        "limit": {"expr": "categoryLabelLimit"}
      },
      "encoding": {
        "x": {"datum": 0, "type": "quantitative", "scale": {"domain": [0, 1], "nice": false, "zero": true}, "axis": null},
        "text": {"field": "catLines"}
      }
    },
    {
      "transform": [{"filter": "datum.labelTotalShown"}],
      "mark": {
        "type": "text",
        "baseline": "middle",
        "align": {"expr": "datum.labelTotalInside ? 'right' : 'left'"},
        "dx": {"expr": "datum.labelTotalInside ? -labelGap : labelGap"},
        "yOffset": {"expr": "bandwidth('y') * (totalBarOffset - totalBarHeight / 2 + currentBarOffset - currentBarHeight / 2) / 2"},
        "fill": {"expr": "textColor"},
        "fontSize": {"expr": "labelFontSize"}
      },
      "encoding": {
        "x": {"field": "xTotal", "type": "quantitative", "scale": {"domain": [0, 1], "nice": false, "zero": true}, "axis": null},
        "text": {"field": "labelTotal"}
      }
    },
    {
      "transform": [{"filter": "datum.labelCurrentShown"}],
      "mark": {
        "type": "text",
        "baseline": "middle",
        "align": {"expr": "datum.labelCurrentInside ? 'right' : 'left'"},
        "dx": {"expr": "datum.labelCurrentInside ? -labelGap : labelGap"},
        "fill": {"expr": "datum.labelCurrentInside ? currentLabelColor : textColor"},
        "yOffset": {"expr": "!datum.labelCurrentInside && datum.xCurrent < datum.xTotal ? max(bandwidth('y') * currentBarOffset, bandwidth('y') * (totalBarOffset + totalBarHeight / 2) + barStrokeWidth / 2 + 1 + 0.42 * labelFontSize) : bandwidth('y') * currentBarOffset"},
        "fontSize": {"expr": "labelFontSize"}
      },
      "encoding": {
        "x": {"field": "xCurrent", "type": "quantitative", "scale": {"domain": [0, 1], "nice": false, "zero": true}, "axis": null},
        "text": {"field": "labelCurrent"}
      }
