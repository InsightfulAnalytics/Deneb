    "information": {
      "name": "Overlapping Bars with Variance Lollipop",
      "description": "For each category, a current bar coloured good or bad sits in front of a grey comparison bar, and a lollipop beside them shows the % difference. Built for a top-N list against an average. Design after Gerard Duggan (dg-analysis.com).",
      "author": "Timothy Osborn, after Gerard Duggan",
      "uuid": "5acf0450-afef-453e-98aa-e2e8146fa114",
      "generated": "2026-09-23T00:00:00.000Z",
      "previewImageBase64PNG": "data:image/png;base64,"
    },
    "dataset": [
      {
        "key": "__0__",
        "name": "Category",
        "description": "The row label: a customer, product, shipper or similar. One row per category.",
        "type": "text",
        "kind": "column"
      },
      {
        "key": "__1__",
        "name": "Current",
        "description": "The value being judged, for example the reporting month. Drawn as the front bar, coloured by whether it beats the comparison.",
        "type": "numeric",
        "kind": "measure"
      },
      {
        "key": "__2__",
        "name": "Comparison",
        "description": "The value to beat, for example the reporting year average. Drawn as the grey bar behind the current bar.",
        "type": "numeric",
        "kind": "measure"
      }
    ],
    "interactivity": {
      "tooltip": true,
      "contextMenu": true,
      "selection": false,
      "highlight": false,
      "dataPointLimit": 50
    }
  },
  "config": {
    "autosize": {"type": "fit", "contains": "padding"},
    "view": {"stroke": "transparent"},
    "background": "transparent",
    "font": "Segoe UI"
  },
  "params": [
    {"name": "title", "value": ""},
    {"name": "subtitle", "value": ""},
    {"name": "higherIsBetter", "value": true},
    {"name": "valueFormat", "value": "$,.1f"},
    {"name": "valueDivisor", "value": 1},
    {"name": "valueSuffix", "value": ""},
    {"name": "percentFormat", "value": "+.1%"},
    {"name": "sortBy", "value": "current"},
    {"name": "sortDescending", "value": true},
    {"name": "colorGood", "expr": "pbiColor('good')"},
    {"name": "colorBad", "expr": "pbiColor('bad')"},
    {"name": "colorNeutral", "expr": "pbiColor('neutral')"},
    {"name": "colorComparisonFill", "value": "#E1DFDD"},
    {"name": "colorComparisonOutline", "value": "#A19F9D"},
    {"name": "colorTextPrimary", "value": "#252423"},
    {"name": "colorTextSecondary", "value": "#605E5C"},
    {"name": "colorLabelOnBar", "value": "#FFFFFF"},
    {"name": "colorLabelOnNeutral", "value": "#252423"},
    {"name": "comparisonOutlineWidth", "value": 1},
    {"name": "lollipopHeadTint", "value": 0.75},
    {"name": "lollipopHeadStrokeWidth", "value": 1.5},
    {"name": "titleFontSize", "value": 13},
    {"name": "subtitleFontSize", "value": 10},
    {"name": "categoryFontSize", "value": 12},
    {"name": "valueFontSize", "value": 10},
    {"name": "percentFontSize", "value": 11},
    {"name": "labelColumnShare", "value": 0.28},
    {"name": "lollipopShare", "value": 0.2},
    {"name": "comparisonBarSize", "value": 0.42},
    {"name": "currentBarSize", "value": 0.3},
    {"name": "comparisonBarOffset", "value": -0.1},
    {"name": "currentBarOffset", "value": 0.12},
    {"name": "lollipopHeadRadius", "value": 5},
    {"name": "lollipopStemWidth", "value": 2.5}
  ],
  "data": {"name": "dataset"},
  "transform": [
    {"calculate": "isValid(datum['__0__']) ? datum['__0__'] + '' : '(Blank)'", "as": "category"},
    {"calculate": "isValid(datum['__1__']) && isFinite(toNumber(datum['__1__'])) ? toNumber(datum['__1__']) : null", "as": "current"},
    {"calculate": "isValid(datum['__2__']) && isFinite(toNumber(datum['__2__'])) ? toNumber(datum['__2__']) : null", "as": "comparison"},
    {"calculate": "isValid(datum.current) && isValid(datum.comparison) && datum.comparison != 0 ? (datum.current - datum.comparison) / abs(datum.comparison) : null", "as": "difference"},
    {"calculate": "!isValid(datum.difference) || datum.difference == 0 ? 'neutral' : ((datum.difference > 0) === (higherIsBetter === true || higherIsBetter === 'true') ? 'good' : 'bad')", "as": "status"},
    {"calculate": "datum.status == 'good' ? colorGood : datum.status == 'bad' ? colorBad : colorNeutral", "as": "statusColor"},
    {"calculate": "rgb(datum.statusColor)", "as": "statusRgb"},
    {"calculate": "'rgb(' + round(datum.statusRgb.r + (255 - datum.statusRgb.r) * lollipopHeadTint) + ',' + round(datum.statusRgb.g + (255 - datum.statusRgb.g) * lollipopHeadTint) + ',' + round(datum.statusRgb.b + (255 - datum.statusRgb.b) * lollipopHeadTint) + ')'", "as": "headFill"},
    {"window": [{"op": "row_number", "as": "categoryRank"}], "sort": [{"field": "category", "order": "ascending"}]},
    {"calculate": "sortBy == 'category' ? datum.categoryRank : sortBy == 'comparison' ? datum.comparison : sortBy == 'difference' ? datum.difference : datum.current", "as": "sortRaw"},
    {"calculate": "isValid(datum.sortRaw) ? (sortDescending ? -datum.sortRaw : datum.sortRaw) : 1e300", "as": "sortValue"},
    {"window": [{"op": "row_number", "as": "rowIndex"}], "sort": [{"field": "sortValue", "order": "ascending"}, {"field": "categoryRank", "order": "ascending"}]},
    {"joinaggregate": [
      {"op": "count", "as": "rowCount"},
      {"op": "max", "field": "current", "as": "maxCurrent"},
      {"op": "max", "field": "comparison", "as": "maxComparison"},
      {"op": "min", "field": "difference", "as": "minDifference"},
      {"op": "max", "field": "difference", "as": "maxDifference"}
    ]},
    {"calculate": "(length(title) > 0 ? titleFontSize * 1.35 : 0) + (length(subtitle) > 0 ? subtitleFontSize * 1.35 : 0) + (length(title) + length(subtitle) > 0 ? 6 : 0)", "as": "plotTop"},
    {"calculate": "width * labelColumnShare", "as": "labelRight"},
    {"calculate": "datum.labelRight + 8", "as": "barStart"},
    {"calculate": "percentFontSize * 5", "as": "percentSpace"},
    {"calculate": "width - datum.percentSpace - 4", "as": "lollipopRight"},
    {"calculate": "datum.lollipopRight - width * lollipopShare", "as": "lollipopLeft"},
    {"calculate": "max(datum.lollipopLeft - 10 - datum.barStart, 1)", "as": "barSpan"},
    {"calculate": "max(isValid(datum.maxCurrent) ? datum.maxCurrent : 0, isValid(datum.maxComparison) ? datum.maxComparison : 0) > 0 ? max(isValid(datum.maxCurrent) ? datum.maxCurrent : 0, isValid(datum.maxComparison) ? datum.maxComparison : 0) : 1", "as": "valueMax"},
    {"calculate": "datum.barStart + max(0, isValid(datum.current) ? datum.current : 0) / datum.valueMax * datum.barSpan", "as": "currentX"},
    {"calculate": "datum.barStart + max(0, isValid(datum.comparison) ? datum.comparison : 0) / datum.valueMax * datum.barSpan", "as": "comparisonX"},
    {"calculate": "max(0, height - datum.plotTop) / datum.rowCount", "as": "rowHeight"},
    {"calculate": "datum.plotTop + (datum.rowIndex - 0.5) * datum.rowHeight", "as": "rowCenter"},
    {"calculate": "datum.rowCenter + (comparisonBarOffset - comparisonBarSize / 2) * datum.rowHeight", "as": "comparisonTop"},
    {"calculate": "datum.comparisonTop + comparisonBarSize * datum.rowHeight", "as": "comparisonBottom"},
    {"calculate": "datum.rowCenter + (currentBarOffset - currentBarSize / 2) * datum.rowHeight", "as": "currentTop"},
    {"calculate": "datum.currentTop + currentBarSize * datum.rowHeight", "as": "currentBottom"},
    {"calculate": "(min(datum.comparisonTop, datum.currentTop) + max(datum.comparisonBottom, datum.currentBottom)) / 2", "as": "groupCenter"},
    {"calculate": "datum.currentTop > datum.comparisonTop ? (datum.comparisonTop + min(datum.currentTop, datum.comparisonBottom)) / 2 : (datum.comparisonTop + datum.comparisonBottom) / 2", "as": "comparisonLabelY"},
    {"calculate": "(datum.currentTop + datum.currentBottom) / 2", "as": "currentLabelY"},
    {"calculate": "isValid(datum.current) ? format(datum.current / valueDivisor, valueFormat) + valueSuffix : ''", "as": "currentText"},
    {"calculate": "isValid(datum.comparison) ? format(datum.comparison / valueDivisor, valueFormat) + valueSuffix : ''", "as": "comparisonText"},
    {"calculate": "datum.currentX - datum.barStart >= length(datum.currentText) * valueFontSize * 0.55 + 6", "as": "currentInside"},
    {"calculate": "datum.comparisonX - datum.barStart >= length(datum.comparisonText) * valueFontSize * 0.55 + 6", "as": "comparisonInside"},
    {"calculate": "(datum.currentTop > datum.comparisonTop ? min(datum.currentTop, datum.comparisonBottom) : datum.comparisonBottom) - datum.comparisonTop >= valueFontSize", "as": "comparisonLabelFits"},
    {"calculate": "datum.status == 'neutral' ? colorLabelOnNeutral : colorLabelOnBar", "as": "currentLabelColor"},
    {"calculate": "min(0, isValid(datum.minDifference) ? datum.minDifference : 0)", "as": "differenceMin"},
    {"calculate": "max(0, isValid(datum.maxDifference) ? datum.maxDifference : 0)", "as": "differenceMax"},
    {"calculate": "datum.lollipopLeft + lollipopHeadRadius + 1", "as": "headLeft"},
    {"calculate": "max(datum.lollipopRight - lollipopHeadRadius - 1, datum.headLeft)", "as": "headRight"},
    {"calculate": "datum.headLeft + (0 - datum.differenceMin) / max(datum.differenceMax - datum.differenceMin, 1e-9) * (datum.headRight - datum.headLeft)", "as": "zeroX"},
    {"calculate": "isValid(datum.difference) ? datum.headLeft + (datum.difference - datum.differenceMin) / max(datum.differenceMax - datum.differenceMin, 1e-9) * (datum.headRight - datum.headLeft) : null", "as": "headX"},
    {"calculate": "isValid(datum.difference) ? format(datum.difference, percentFormat) : ''", "as": "percentText"},
    {"calculate": "max(isValid(datum.headX) ? datum.headX + lollipopHeadRadius : 0, datum.zeroX) + 4", "as": "percentX"},
    {"calculate": "max(3, floor((datum.labelRight - 4) / (categoryFontSize * 0.52)))", "as": "labelChars"},
    {"calculate": "length(datum.category) <= datum.labelChars || datum.rowHeight < categoryFontSize * 2.5 ? -1 : (lastindexof(substring(datum.category, 0, datum.labelChars + 1), ' ') > 0 ? lastindexof(substring(datum.category, 0, datum.labelChars + 1), ' ') : indexof(datum.category, ' '))", "as": "labelCut"},
    {"calculate": "datum.labelCut > 0 ? [substring(datum.category, 0, datum.labelCut), substring(datum.category, datum.labelCut + 1)] : [datum.category]", "as": "labelLines"}
  ],
  "encoding": {
    "tooltip": [
      {"field": "__0__", "type": "nominal"},
