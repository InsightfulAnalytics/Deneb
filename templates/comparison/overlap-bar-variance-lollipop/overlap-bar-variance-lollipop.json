        "y": {"field": "currentLabelY", "type": "quantitative", "scale": null},
        "text": {"field": "currentText", "type": "nominal"},
        "fill": {"field": "currentLabelColor", "type": "nominal", "scale": null}
      }
    },
    {
      "transform": [{"filter": "isValid(datum.current) && !datum.currentInside"}],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 4,
        "fontSize": {"expr": "valueFontSize"},
