        "y": {"field": "comparisonLabelY", "type": "quantitative", "scale": null},
        "text": {"field": "comparisonText", "type": "nominal"}
      }
    },
    {
      "transform": [{"filter": "isValid(datum.current) && datum.currentInside"}],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -4,
        "fontSize": {"expr": "valueFontSize"}
