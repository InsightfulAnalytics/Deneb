        "y": {"field": "comparisonLabelY", "type": "quantitative", "scale": null},
        "text": {"field": "comparisonText", "type": "nominal"}
      }
    },
    {
      "transform": [{"filter": "isValid(datum.comparison) && datum.comparisonLabelFits && !datum.comparisonInside"}],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 4,
