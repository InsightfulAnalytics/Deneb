{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "usermeta": {
    "deneb": {
      "build": "1.9.1.0",
      "metaVersion": 1,
      "provider": "vegaLite",
      "providerVersion": "6.4.1"
    },
    "information": {
      "name": "Odd Rows P&L Statement",
      "description": "A performant 13-row P&L statement, far faster than a Power BI matrix or table: the five main lines plus margins, cost ratios and per-store and per-product results, current period and year to date, derived in the spec from 30 rows. Design by Timothy Osborn.",
      "author": "Timothy Osborn",
      "uuid": "bafe36ee-2eee-46fc-834f-8be982cc5f1f",
      "generated": "2026-09-23T00:00:00.000Z",
      "previewImageBase64PNG": "data:image/png;base64,"
    },
    "dataset": [
      {
        "key": "__0__",
        "name": "Line",
        "description": "Statement line. Must carry the five lines Total Income, Total Cost of Sales, Gross Profit, Total Operating Expenses and Net Profit.",
        "type": "text",
        "kind": "column"
      },
      {
        "key": "__1__",
        "name": "P&L View",
        "description": "Scenario and period of the amount: Actual, LY, Budget, YTD Actual, YTD LY or YTD Budget.",
        "type": "text",
        "kind": "column"
      },
      {
        "key": "__2__",
        "name": "Amount",
        "description": "Amount for the line and view. Costs are stored as negative numbers.",
        "type": "numeric",
        "kind": "measure"
      },
      {
        "key": "__3__",
        "name": "Trading Stores",
        "description": "Count of trading stores for the view, ignoring the line filter.",
        "type": "numeric",
        "kind": "measure"
      },
      {
        "key": "__4__",
        "name": "Active Products",
        "description": "Count of active products for the view, ignoring the line filter.",
        "type": "numeric",
        "kind": "measure"
      }
    ],
    "interactivity": {
      "tooltip": true,
      "contextMenu": true,
      "selection": false,
      "highlight": false,
      "dataPointLimit": 50
    }
  },
  "config": {
    "autosize": {
      "type": "fit",
      "contains": "padding"
    },
    "view": {
      "stroke": "transparent"
    },
    "background": "transparent",
    "font": "Segoe UI",
    "rule": {
      "strokeCap": "butt"
    }
  },
  "params": [
    {
      "name": "accentColor",
      "expr": "pbiColor(0)"
    },
    {
      "name": "negativeColor",
      "expr": "pbiColor('bad')"
    },
    {
      "name": "textColor",
      "value": "#1F252D"
    },
    {
      "name": "strongTextColor",
      "value": "#000000"
    },
    {
      "name": "mutedTextColor",
      "value": "#4A5361"
    },
    {
      "name": "ruleColor",
      "value": "#9AA3AF"
    },
    {
      "name": "dividerColor",
      "value": "#D3D8DF"
    },
    {
      "name": "bandColor",
      "value": "#161C24"
    },
    {
      "name": "bandOpacity",
      "value": 0.045
    },
    {
      "name": "labelWidth",
      "value": 280
    },
    {
      "name": "fontSize",
      "value": 14
    },
    {
      "name": "headerFontSize",
      "value": 12
    },
    {
      "name": "captionFontSize",
      "value": 11.5
    },
    {
      "name": "labelCaption",
      "value": "STATEMENT LINE"
    },
    {
      "name": "periodCaption",
      "value": "CURRENT PERIOD"
    },
    {
      "name": "ytdCaption",
      "value": "YEAR TO DATE"
    },
    {
      "name": "currencySymbol",
      "value": "$"
    },
    {
      "name": "percentFormat",
      "value": ".1%"
    },
    {
      "name": "countFormat",
      "value": ",.0f"
    }
  ],
  "data": {
    "name": "dataset"
  },
  "padding": {
    "left": 4,
    "top": 10,
    "right": 16,
    "bottom": 14
  },
  "transform": [
    {
      "calculate": "datum['__0__']",
      "as": "Line"
    },
    {
      "calculate": "datum['__1__']",
      "as": "P&L View"
    },
    {
      "calculate": "datum['__2__']",
      "as": "Amount"
    },
    {
      "calculate": "datum['__3__']",
      "as": "Trading Stores"
    },
    {
      "calculate": "datum['__4__']",
      "as": "Active Products"
    },
    {
      "pivot": "Line",
      "value": "Amount",
      "op": "max",
      "groupby": [
        "P&L View",
        "Trading Stores",
        "Active Products"
      ]
    },
    {
      "calculate": "datum['Gross Profit'] / datum['Total Income']",
      "as": "Gross Margin %"
    },
    {
      "calculate": "datum['Net Profit'] / datum['Total Income']",
      "as": "Net Margin %"
    },
    {
      "calculate": "-datum['Total Cost of Sales'] / datum['Total Income']",
      "as": "COGS % of Income"
    },
    {
      "calculate": "-datum['Total Operating Expenses'] / datum['Total Income']",
      "as": "Opex % of Income"
    },
    {
      "calculate": "datum['Total Income'] / datum['Trading Stores']",
      "as": "Income per Trading Store"
    },
    {
      "calculate": "datum['Net Profit'] / datum['Trading Stores']",
      "as": "Net Profit per Trading Store"
    },
    {
      "calculate": "datum['Total Income'] / datum['Active Products']",
      "as": "Income per Active Product"
    },
    {
      "fold": [
        "Total Income",
        "Total Cost of Sales",
        "Gross Profit",
        "Total Operating Expenses",
        "Net Profit",
        "Gross Margin %",
        "Net Margin %",
        "COGS % of Income",
        "Opex % of Income",
        "Income per Trading Store",
        "Net Profit per Trading Store",
        "Income per Active Product",
        "Trading Stores"
      ],
      "as": [
        "metric",
        "baseValue"
      ]
    },
    {
      "pivot": "P&L View",
      "value": "baseValue",
      "op": "max",
      "groupby": [
        "metric"
      ]
    },
    {
      "calculate": "datum['Actual'] - datum['LY']",
      "as": "vs LY"
    },
    {
      "calculate": "(datum['Actual'] - datum['LY']) / datum['LY']",
      "as": "vs LY %"
    },
    {
      "calculate": "datum['Actual'] - datum['Budget']",
      "as": "Var to Budget"
    },
    {
      "calculate": "(datum['Actual'] - datum['Budget']) / datum['Budget']",
      "as": "Var to Budget %"
    },
    {
      "calculate": "datum['YTD Actual'] - datum['YTD LY']",
      "as": "YTD vs LY"
    },
    {
      "calculate": "(datum['YTD Actual'] - datum['YTD LY']) / datum['YTD LY']",
      "as": "YTD vs LY %"
    },
    {
      "calculate": "datum['YTD Actual'] - datum['YTD Budget']",
      "as": "YTD Var to Budget"
    },
    {
      "calculate": "(datum['YTD Actual'] - datum['YTD Budget']) / datum['YTD Budget']",
      "as": "YTD Var to Budget %"
    },
    {
      "fold": [
        "Actual",
        "LY",
        "vs LY",
        "vs LY %",
        "Budget",
        "Var to Budget",
        "Var to Budget %",
        "YTD Actual",
        "YTD LY",
        "YTD vs LY",
        "YTD vs LY %",
        "YTD Budget",
        "YTD Var to Budget",
        "YTD Var to Budget %"
      ],
      "as": [
        "column",
        "value"
      ]
    },
    {
      "calculate": "indexof(datum.column, '%') >= 0",
      "as": "isPctCol"
    },
    {
      "calculate": "indexof(['vs LY','vs LY %','Var to Budget','Var to Budget %','YTD vs LY','YTD vs LY %','YTD Var to Budget','YTD Var to Budget %'], datum.column) >= 0",
      "as": "isVarCol"
    },
    {
      "calculate": "datum.isPctCol || indexof(['Gross Margin %','Net Margin %','COGS % of Income','Opex % of Income'], datum.metric) >= 0",
      "as": "isPct"
    },
    {
      "calculate": "indexof(['Gross Profit','Net Profit'], datum.metric) >= 0",
      "as": "isSubtotal"
    },
    {
      "calculate": "indexof(['Total Income','Total Cost of Sales','Gross Profit','Total Operating Expenses','Net Profit','Gross Margin %','Net Margin %','COGS % of Income','Opex % of Income','Income per Trading Store','Net Profit per Trading Store','Income per Active Product','Trading Stores'], datum.metric)",
      "as": "rowIdx"
    },
    {
      "calculate": "indexof(['Actual','LY','vs LY','vs LY %','Budget','Var to Budget','Var to Budget %','YTD Actual','YTD LY','YTD vs LY','YTD vs LY %','YTD Budget','YTD Var to Budget','YTD Var to Budget %'], datum.column)",
      "as": "colIdx"
    },
    {
      "calculate": "datum.rowIdx + 0.5",
      "as": "rowMid"
    },
    {
      "calculate": "datum.rowIdx + 1",
      "as": "rowEnd"
    },
    {
      "calculate": "datum.colIdx + 1",
      "as": "colEnd"
    },
    {
      "calculate": "abs(datum.value)",
      "as": "absValue"
    },
    {
      "calculate": "datum.isPct ? format(datum.absValue, percentFormat) : (datum.metric === 'Trading Stores' ? format(datum.absValue, countFormat) : (datum.absValue >= 999950 ? currencySymbol + format(datum.absValue / 1000000, ',.1f') + 'M' : (datum.absValue >= 999.5 ? currencySymbol + format(datum.absValue / 1000, ',.1f') + 'K' : currencySymbol + format(datum.absValue, ',.0f'))))",
      "as": "body"
    },
    {
      "calculate": "(!isValid(datum.value) || !isFinite(datum.value)) ? '' : (datum.value < 0 ? '(' + datum.body + ')' : datum.body)",
      "as": "cell"
    },
    {
      "calculate": "-0.11",
      "as": "headerRuleY"
    }
  ],
  "layer": [
    {
      "description": "zebra banding on odd rows, spanning the label gutter and the grid",
      "transform": [
        {
          "filter": "datum.column === 'Actual' && datum.rowIdx % 2 === 1"
        }
      ],
      "mark": {
        "type": "rect",
        "fill": {
          "expr": "bandColor"
        },
        "fillOpacity": {
          "expr": "bandOpacity"
        },
        "x": {
          "expr": "-labelWidth"
        },
        "x2": "width"
      },
      "encoding": {
        "y": {
          "field": "rowIdx",
          "type": "quantitative",
          "scale": {
            "domain": [
              13,
              0
            ],
            "nice": false,
            "zero": false,
            "clamp": false
          },
          "axis": null,
          "title": null
        },
        "y2": {
          "field": "rowEnd"
        }
      }
    },
    {
      "description": "accent rule under the column headers",
      "transform": [
        {
          "filter": "datum.column === 'Actual' && datum.metric === 'Total Income'"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": {
          "expr": "accentColor"
        },
        "strokeWidth": 1.5,
        "opacity": 0.9,
        "x": {
          "expr": "-labelWidth"
        },
        "x2": "width"
      },
      "encoding": {
        "y": {
          "field": "headerRuleY",
          "type": "quantitative",
          "scale": {
            "domain": [
              13,
              0
            ],
            "nice": false,
            "zero": false,
            "clamp": false
          },
          "axis": null,
          "title": null
        }
      }
    },
    {
      "description": "vertical dividers: end of the label gutter, and the period and YTD split",
      "transform": [
        {
          "filter": "datum.metric === 'Total Income' && (datum.column === 'Actual' || datum.column === 'YTD Actual')"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": {
          "expr": "dividerColor"
        },
        "y": -46
      },
      "encoding": {
        "x": {
          "field": "colIdx",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              14
            ],
            "nice": false,
            "zero": false,
            "clamp": false
          },
          "axis": null,
          "title": null
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.column === 'YTD Actual'",
            "value": 1.5
          },
          "value": 1
        }
      }
    },
    {
      "description": "rule above each subtotal line and above the ratio block",
      "transform": [
        {
          "filter": "datum.column === 'Actual' && (datum.isSubtotal || datum.metric === 'Gross Margin %')"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": {
          "expr": "ruleColor"
        },
        "strokeWidth": 1,
        "opacity": 0.8,
        "x": {
          "expr": "-labelWidth"
        },
        "x2": "width"
      },
      "encoding": {
        "y": {
          "field": "rowIdx",
          "type": "quantitative",
          "scale": {
            "domain": [
              13,
              0
            ],
            "nice": false,
            "zero": false,
            "clamp": false
          },
          "axis": null,
          "title": null
        }
      }
    },
    {
      "description": "closing rule under the last row",
      "transform": [
        {
          "filter": "datum.column === 'Actual' && datum.metric === 'Trading Stores'"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": {
          "expr": "ruleColor"
        },
        "strokeWidth": 1,
        "opacity": 0.8,
        "x": {
          "expr": "-labelWidth"
        },
        "x2": "width"
      },
      "encoding": {
        "y": {
          "field": "rowEnd",
          "type": "quantitative",
          "scale": {
            "domain": [
              13,
              0
            ],
            "nice": false,
            "zero": false,
            "clamp": false
          },
          "axis": null,
          "title": null
        }
      }
    },
    {
      "description": "half captions",
      "transform": [
        {
          "filter": "datum.metric === 'Total Income' && (datum.column === 'Actual' || datum.column === 'YTD Actual')"
        },
        {
          "calculate": "datum.column === 'Actual' ? periodCaption : ytdCaption",
          "as": "groupLabel"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": {
          "expr": "captionFontSize"
        },
        "fontWeight": 700,
        "fill": {
          "expr": "accentColor"
        },
        "opacity": 0.95,
        "y": -38,
        "xOffset": 4
      },
      "encoding": {
        "x": {
          "field": "colIdx",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              14
            ],
            "nice": false,
            "zero": false,
            "clamp": false
          },
          "axis": null,
          "title": null
        },
        "text": {
          "field": "groupLabel",
          "type": "nominal"
        }
      }
    },
    {
      "description": "row-label gutter caption",
      "transform": [
        {
          "filter": "datum.metric === 'Total Income' && datum.column === 'Actual'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": {
          "expr": "captionFontSize"
        },
        "fontWeight": 700,
        "fill": {
          "expr": "mutedTextColor"
        },
        "y": -38,
        "x": {
          "expr": "4 - labelWidth"
        },
        "text": {
          "expr": "labelCaption"
        }
      },
      "encoding": {}
    },
    {
      "description": "column headers (the leading 'YTD ' is stripped, the half caption already says it)",
      "transform": [
        {
          "filter": "datum.metric === 'Total Income'"
        },
        {
          "calculate": "indexof(datum.column, 'YTD ') === 0 ? slice(datum.column, 4) : datum.column",
          "as": "headerBase"
        },
        {
          "calculate": "indexof(datum.headerBase, 'Var to ') === 0 ? ['Var to', slice(datum.headerBase, 7)] : datum.headerBase",
          "as": "headerText"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "fontSize": {
          "expr": "headerFontSize"
        },
        "y": -22,
        "xOffset": -11,
        "fontWeight": {
          "expr": "(datum.column === 'Actual' || datum.column === 'YTD Actual') ? 700 : 600"
        },
        "lineHeight": 11,
        "limit": {
          "expr": "width / 14 - 6"
        }
      },
      "encoding": {
        "x": {
          "field": "colEnd",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              14
            ],
            "nice": false,
            "zero": false,
            "clamp": false
          },
          "axis": null,
          "title": null
        },
        "text": {
          "field": "headerText",
          "type": "nominal"
        },
        "fill": {
          "condition": {
            "test": "datum.column === 'Actual' || datum.column === 'YTD Actual'",
            "value": {
              "expr": "strongTextColor"
            }
          },
          "value": {
            "expr": "mutedTextColor"
          }
        }
      }
    },
    {
      "description": "row labels in the left gutter",
      "transform": [
        {
          "filter": "datum.column === 'Actual'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": {
          "expr": "fontSize"
        },
        "x": {
          "expr": "4 - labelWidth"
        },
        "limit": {
          "expr": "labelWidth + 20"
        },
        "fontWeight": {
          "expr": "datum.isSubtotal ? 700 : 400"
        }
      },
      "encoding": {
        "y": {
          "field": "rowMid",
          "type": "quantitative",
          "scale": {
            "domain": [
              13,
              0
            ],
            "nice": false,
            "zero": false,
            "clamp": false
          },
          "axis": null,
          "title": null
        },
        "text": {
          "field": "metric",
          "type": "nominal"
        },
        "fill": {
          "condition": {
            "test": "datum.isSubtotal",
            "value": {
              "expr": "strongTextColor"
            }
          },
          "value": {
            "expr": "textColor"
          }
        }
      }
    },
    {
      "description": "the 182 numbers",
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "fontSize": {
          "expr": "fontSize"
        },
        "xOffset": -11,
        "fontWeight": {
          "expr": "datum.isSubtotal ? 700 : 400"
        }
      },
      "encoding": {
        "x": {
          "field": "colEnd",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              14
            ],
            "nice": false,
            "zero": false,
            "clamp": false
          },
          "axis": null,
          "title": null
        },
        "y": {
          "field": "rowMid",
          "type": "quantitative",
          "scale": {
            "domain": [
              13,
              0
            ],
            "nice": false,
            "zero": false,
            "clamp": false
          },
          "axis": null,
          "title": null
        },
        "text": {
          "field": "cell",
          "type": "nominal"
        },
        "fill": {
          "condition": [
            {
              "test": "datum.isVarCol && datum.value < 0",
              "value": {
                "expr": "negativeColor"
              }
            },
            {
              "test": "datum.isSubtotal",
              "value": {
                "expr": "strongTextColor"
              }
            },
            {
              "test": "datum.column === 'Actual' || datum.column === 'YTD Actual'",
              "value": {
                "expr": "strongTextColor"
              }
            }
          ],
          "value": {
            "expr": "textColor"
          }
        }
      }
    },
    {
      "description": "invisible full-cell rects so every cell is hoverable, blanks included",
      "mark": {
        "type": "rect",
        "fill": {
          "expr": "bandColor"
        },
        "fillOpacity": 0
      },
      "encoding": {
        "x": {
          "field": "colIdx",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              14
            ],
            "nice": false,
            "zero": false,
            "clamp": false
          },
          "axis": null,
          "title": null
        },
        "x2": {
          "field": "colEnd"
        },
        "y": {
          "field": "rowIdx",
          "type": "quantitative",
          "scale": {
            "domain": [
              13,
              0
            ],
            "nice": false,
            "zero": false,
            "clamp": false
          },
          "axis": null,
          "title": null
        },
        "y2": {
          "field": "rowEnd"
        },
        "tooltip": [
          {
            "field": "metric",
            "type": "nominal",
            "title": "Line"
          },
          {
            "field": "column",
            "type": "nominal",
            "title": "Column"
          },
          {
            "field": "cell",
            "type": "nominal",
            "title": "Value"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Raw",
            "format": ",.4f"
          }
        ]
      }
    }
  ]
}
