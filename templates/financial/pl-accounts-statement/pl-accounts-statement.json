{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "usermeta": {
    "deneb": {
      "build": "1.9.1.0",
      "metaVersion": 1,
      "provider": "vegaLite",
      "providerVersion": "6.4.1"
    },
    "information": {
      "name": "P&L Accounts Statement",
      "description": "A performant account-level P&L statement, far faster than a Power BI matrix or table: the model returns base measures only, and every variance, subtotal and format is derived in the spec. Current period and year to date against budget and last year. Design by Timothy Osborn.",
      "author": "Timothy Osborn",
      "uuid": "b94aece1-6c9f-4726-bfb4-c0056b32f21c",
      "generated": "2026-09-23T00:00:00.000Z",
      "previewImageBase64PNG": "data:image/png;base64,"
    },
    "dataset": [
      {
        "key": "__0__",
        "name": "Line",
        "description": "Statement line label, one row per line. A leading indent is stripped; LineClass sets the indent.",
        "type": "text",
        "kind": "column"
      },
      {
        "key": "__1__",
        "name": "LineKey",
        "description": "Sort key for the lines, ascending. Any increasing numbers work.",
        "type": "numeric",
        "kind": "column"
      },
      {
        "key": "__2__",
        "name": "LineClass",
        "description": "Detail for an account line. Any other value (Subtotal, Total) is drawn bold with a rule above.",
        "type": "text",
        "kind": "column"
      },
      {
        "key": "__3__",
        "name": "Actual",
        "description": "Actual amount for the current period. Costs are negative.",
        "type": "numeric",
        "kind": "measure"
      },
      {
        "key": "__4__",
        "name": "Budget",
        "description": "Budget amount for the current period. Costs are negative.",
        "type": "numeric",
        "kind": "measure"
      },
      {
        "key": "__5__",
        "name": "LY",
        "description": "Last year's actual for the same period. Costs are negative.",
        "type": "numeric",
        "kind": "measure"
      },
      {
        "key": "__6__",
        "name": "YTD Actual",
        "description": "Actual amount, year to date. Costs are negative.",
        "type": "numeric",
        "kind": "measure"
      },
      {
        "key": "__7__",
        "name": "YTD Budget",
        "description": "Budget amount, year to date. Costs are negative.",
        "type": "numeric",
        "kind": "measure"
      },
      {
        "key": "__8__",
        "name": "YTD LY",
        "description": "Last year's actual, year to date. Costs are negative.",
        "type": "numeric",
        "kind": "measure"
      }
    ],
    "interactivity": {
      "tooltip": true,
      "contextMenu": true,
      "selection": false,
      "highlight": false,
      "dataPointLimit": 50
    }
  },
  "config": {
    "autosize": {
      "type": "fit",
      "contains": "padding"
    },
    "view": {
      "stroke": "transparent"
    },
    "background": "transparent",
    "font": "Segoe UI",
    "rule": {
      "strokeCap": "butt"
    }
  },
  "params": [
    {
      "name": "accentColor",
      "expr": "pbiColor(0)"
    },
    {
      "name": "negativeColor",
      "expr": "pbiColor('bad')"
    },
    {
      "name": "textColor",
      "value": "#1F252D"
    },
    {
      "name": "strongTextColor",
      "value": "#000000"
    },
    {
      "name": "mutedTextColor",
      "value": "#4A5361"
    },
    {
      "name": "ruleColor",
      "value": "#9AA3AF"
    },
    {
      "name": "dividerColor",
      "value": "#D3D8DF"
    },
    {
      "name": "bandColor",
      "value": "#161C24"
    },
    {
      "name": "bandOpacity",
      "value": 0.045
    },
    {
      "name": "labelWidth",
      "value": 280
    },
    {
      "name": "indentWidth",
      "value": 16
    },
    {
      "name": "fontSize",
      "value": 14
    },
    {
      "name": "headerFontSize",
      "value": 12
    },
    {
      "name": "captionFontSize",
      "value": 11.5
    },
    {
      "name": "labelCaption",
      "value": "STATEMENT LINE"
    },
    {
      "name": "periodCaption",
      "value": "CURRENT PERIOD"
    },
    {
      "name": "ytdCaption",
      "value": "YEAR TO DATE"
    },
    {
      "name": "currencySymbol",
      "value": "$"
    },
    {
      "name": "percentFormat",
      "value": ".1%"
    },
    {
      "name": "detailLineClass",
      "value": "Detail"
    },
    {
      "name": "rowCount",
      "expr": "length(data('dataset'))"
    }
  ],
  "data": {
    "name": "dataset"
  },
  "padding": {
    "left": 4,
    "top": 10,
    "right": 16,
    "bottom": 14
  },
  "transform": [
    {
      "calculate": "datum['__0__']",
      "as": "Line"
    },
    {
      "calculate": "datum['__1__']",
      "as": "LineKey"
    },
    {
      "calculate": "datum['__2__']",
      "as": "LineClass"
    },
    {
      "calculate": "datum['__3__']",
      "as": "Actual"
    },
    {
      "calculate": "datum['__4__']",
      "as": "Budget"
    },
    {
      "calculate": "datum['__5__']",
      "as": "LY"
    },
    {
      "calculate": "datum['__6__']",
      "as": "YTD Actual"
    },
    {
      "calculate": "datum['__7__']",
      "as": "YTD Budget"
    },
    {
      "calculate": "datum['__8__']",
      "as": "YTD LY"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "rowRank"
        }
      ],
      "sort": [
        {
          "field": "LineKey",
          "order": "ascending"
        }
      ]
    },
    {
      "calculate": "datum.rowRank - 1",
      "as": "rowIdx"
    },
    {
      "calculate": "datum['Actual'] - datum['Budget']",
      "as": "Var"
    },
    {
      "calculate": "(datum['Actual'] - datum['Budget']) / datum['Budget']",
      "as": "Var %"
    },
    {
      "calculate": "datum['Actual'] - datum['LY']",
      "as": "vs LY"
    },
    {
      "calculate": "(datum['Actual'] - datum['LY']) / datum['LY']",
      "as": "vs LY %"
    },
    {
      "calculate": "datum['YTD Actual'] - datum['YTD Budget']",
      "as": "YTD Var"
    },
    {
      "calculate": "(datum['YTD Actual'] - datum['YTD Budget']) / datum['YTD Budget']",
      "as": "YTD Var %"
    },
    {
      "calculate": "datum['YTD Actual'] - datum['YTD LY']",
      "as": "YTD vs LY"
    },
    {
      "calculate": "(datum['YTD Actual'] - datum['YTD LY']) / datum['YTD LY']",
      "as": "YTD vs LY %"
    },
    {
      "fold": [
        "Actual",
        "Budget",
        "Var",
        "Var %",
        "LY",
        "vs LY",
        "vs LY %",
        "YTD Actual",
        "YTD Budget",
        "YTD Var",
        "YTD Var %",
        "YTD LY",
        "YTD vs LY",
        "YTD vs LY %"
      ],
      "as": [
        "column",
        "value"
      ]
    },
    {
      "calculate": "indexof(datum.column, '%') >= 0",
      "as": "isPctCol"
    },
    {
      "calculate": "indexof([\"Var\", \"Var %\", \"vs LY\", \"vs LY %\", \"YTD Var\", \"YTD Var %\", \"YTD vs LY\", \"YTD vs LY %\"], datum.column) >= 0",
      "as": "isVarCol"
    },
    {
      "calculate": "datum.LineClass !== detailLineClass",
      "as": "isSubtotal"
    },
    {
      "calculate": "indexof([\"Actual\", \"Budget\", \"Var\", \"Var %\", \"LY\", \"vs LY\", \"vs LY %\", \"YTD Actual\", \"YTD Budget\", \"YTD Var\", \"YTD Var %\", \"YTD LY\", \"YTD vs LY\", \"YTD vs LY %\"], datum.column)",
      "as": "colIdx"
    },
    {
      "calculate": "datum.rowIdx + 0.5",
      "as": "rowMid"
    },
    {
      "calculate": "datum.rowIdx + 1",
      "as": "rowEnd"
    },
    {
      "calculate": "datum.colIdx + 1",
      "as": "colEnd"
    },
    {
      "calculate": "abs(datum.value)",
      "as": "absValue"
    },
    {
      "calculate": "datum.isPctCol ? format(datum.absValue, percentFormat) : (datum.absValue >= 999950 ? currencySymbol + format(datum.absValue / 1000000, ',.1f') + 'M' : (datum.absValue >= 999.5 ? currencySymbol + format(datum.absValue / 1000, ',.1f') + 'K' : currencySymbol + format(datum.absValue, ',.0f')))",
      "as": "body"
    },
    {
      "calculate": "(!isValid(datum.value) || !isFinite(datum.value)) ? '' : (datum.value < 0 ? '(' + datum.body + ')' : datum.body)",
      "as": "cell"
    },
    {
      "calculate": "-0.11",
      "as": "headerRuleY"
    }
  ],
  "layer": [
    {
      "description": "zebra banding on odd rows, spanning the label gutter and the grid",
      "transform": [
        {
          "filter": "datum.column === 'Actual' && datum.rowIdx % 2 === 1"
        }
      ],
      "mark": {
        "type": "rect",
        "fill": {
          "expr": "bandColor"
        },
        "fillOpacity": {
          "expr": "bandOpacity"
        },
        "x": {
          "expr": "-labelWidth"
        },
        "x2": "width"
      },
      "encoding": {
        "y": {
          "field": "rowIdx",
          "type": "quantitative",
          "scale": {
            "domain": [
              {
                "expr": "rowCount"
              },
              0
            ],
            "nice": false,
            "zero": false,
            "clamp": false
          },
          "axis": null,
          "title": null
        },
        "y2": {
          "field": "rowEnd"
        }
      }
    },
    {
      "description": "accent rule under the column headers",
      "transform": [
        {
          "filter": "datum.column === 'Actual' && datum.rowIdx === 0"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": {
          "expr": "accentColor"
        },
        "strokeWidth": 1.5,
        "opacity": 0.9,
        "x": {
          "expr": "-labelWidth"
        },
        "x2": "width"
      },
      "encoding": {
        "y": {
          "field": "headerRuleY",
          "type": "quantitative",
          "scale": {
            "domain": [
              {
                "expr": "rowCount"
              },
              0
            ],
            "nice": false,
            "zero": false,
            "clamp": false
          },
          "axis": null,
          "title": null
        }
      }
    },
    {
      "description": "vertical dividers: end of the label gutter, and the period and YTD split",
      "transform": [
        {
          "filter": "datum.rowIdx === 0 && (datum.column === 'Actual' || datum.column === 'YTD Actual')"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": {
          "expr": "dividerColor"
        },
        "y": -46
      },
      "encoding": {
        "x": {
          "field": "colIdx",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              14
            ],
            "nice": false,
            "zero": false,
            "clamp": false
          },
          "axis": null,
          "title": null
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.column === 'YTD Actual'",
            "value": 1.5
          },
          "value": 1
        }
      }
    },
    {
      "description": "rule above each subtotal and total line",
      "transform": [
        {
          "filter": "datum.column === 'Actual' && datum.isSubtotal"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": {
          "expr": "ruleColor"
        },
        "strokeWidth": 1,
        "opacity": 0.8,
        "x": {
          "expr": "-labelWidth"
        },
        "x2": "width"
      },
      "encoding": {
        "y": {
          "field": "rowIdx",
          "type": "quantitative",
          "scale": {
            "domain": [
              {
                "expr": "rowCount"
              },
              0
            ],
            "nice": false,
            "zero": false,
            "clamp": false
          },
          "axis": null,
          "title": null
        }
      }
    },
    {
      "description": "closing rule under the last row",
      "transform": [
        {
          "filter": "datum.column === 'Actual' && datum.rowIdx === rowCount - 1"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": {
          "expr": "ruleColor"
        },
        "strokeWidth": 1,
        "opacity": 0.8,
        "x": {
          "expr": "-labelWidth"
        },
        "x2": "width"
      },
      "encoding": {
        "y": {
          "field": "rowEnd",
          "type": "quantitative",
          "scale": {
            "domain": [
              {
                "expr": "rowCount"
              },
              0
            ],
            "nice": false,
            "zero": false,
            "clamp": false
          },
          "axis": null,
          "title": null
        }
      }
    },
    {
      "description": "half captions",
      "transform": [
        {
          "filter": "datum.rowIdx === 0 && (datum.column === 'Actual' || datum.column === 'YTD Actual')"
        },
        {
          "calculate": "datum.column === 'Actual' ? periodCaption : ytdCaption",
          "as": "groupLabel"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": {
          "expr": "captionFontSize"
        },
        "fontWeight": 700,
        "fill": {
          "expr": "accentColor"
        },
        "opacity": 0.95,
        "y": -38,
        "xOffset": 4
      },
      "encoding": {
        "x": {
          "field": "colIdx",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              14
            ],
            "nice": false,
            "zero": false,
            "clamp": false
          },
          "axis": null,
          "title": null
        },
        "text": {
          "field": "groupLabel",
          "type": "nominal"
        }
      }
    },
    {
      "description": "row-label gutter caption",
      "transform": [
        {
          "filter": "datum.rowIdx === 0 && datum.column === 'Actual'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": {
          "expr": "captionFontSize"
        },
        "fontWeight": 700,
        "fill": {
          "expr": "mutedTextColor"
        },
        "y": -38,
        "x": {
          "expr": "4 - labelWidth"
        },
        "text": {
          "expr": "labelCaption"
        }
      },
      "encoding": {}
    },
    {
      "description": "column headers (the leading 'YTD ' is stripped, the half caption already says it)",
      "transform": [
        {
          "filter": "datum.rowIdx === 0"
        },
        {
          "calculate": "indexof(datum.column, 'YTD ') === 0 ? slice(datum.column, 4) : datum.column",
          "as": "headerText"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "fontSize": {
          "expr": "headerFontSize"
        },
        "y": -22,
        "xOffset": -11,
        "limit": {
          "expr": "width / 14 - 6"
        },
        "fontWeight": {
          "expr": "(datum.column === 'Actual' || datum.column === 'YTD Actual') ? 700 : 600"
        }
      },
      "encoding": {
        "x": {
          "field": "colEnd",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              14
            ],
            "nice": false,
            "zero": false,
            "clamp": false
          },
          "axis": null,
          "title": null
        },
        "text": {
          "field": "headerText",
          "type": "nominal"
        },
        "fill": {
          "condition": {
            "test": "datum.column === 'Actual' || datum.column === 'YTD Actual'",
            "value": {
              "expr": "strongTextColor"
            }
          },
          "value": {
            "expr": "mutedTextColor"
          }
        }
      }
    },
    {
      "description": "row labels in the left gutter; the indent is a pixel offset per LineClass, because a baked-in U+00A0 indent does not reliably survive the SVG pipeline",
      "transform": [
        {
          "filter": "datum.column === 'Actual'"
        },
        {
          "calculate": "trim(replace(datum.Line, /\\s+/g, ' '))",
          "as": "lineLabel"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": {
          "expr": "fontSize"
        },
        "x": {
          "expr": "4 - labelWidth + (datum.LineClass === detailLineClass ? indentWidth : 0)"
        },
        "limit": {
          "expr": "labelWidth + 20"
        },
        "fontWeight": {
          "expr": "datum.isSubtotal ? 700 : 400"
        }
      },
      "encoding": {
        "y": {
          "field": "rowMid",
          "type": "quantitative",
          "scale": {
            "domain": [
              {
                "expr": "rowCount"
              },
              0
            ],
            "nice": false,
            "zero": false,
            "clamp": false
          },
          "axis": null,
          "title": null
        },
        "text": {
          "field": "lineLabel",
          "type": "nominal"
        },
        "fill": {
          "condition": {
            "test": "datum.isSubtotal",
            "value": {
              "expr": "strongTextColor"
            }
          },
          "value": {
            "expr": "textColor"
          }
        }
      }
    },
    {
      "description": "the numbers, one per line and column",
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "fontSize": {
          "expr": "fontSize"
        },
        "xOffset": -11,
        "fontWeight": {
          "expr": "datum.isSubtotal ? 700 : 400"
        }
      },
      "encoding": {
        "x": {
          "field": "colEnd",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              14
            ],
            "nice": false,
            "zero": false,
            "clamp": false
          },
          "axis": null,
          "title": null
        },
        "y": {
          "field": "rowMid",
          "type": "quantitative",
          "scale": {
            "domain": [
              {
                "expr": "rowCount"
              },
              0
            ],
            "nice": false,
            "zero": false,
            "clamp": false
          },
          "axis": null,
          "title": null
        },
        "text": {
          "field": "cell",
          "type": "nominal"
        },
        "fill": {
          "condition": [
            {
              "test": "datum.isVarCol && datum.value < 0",
              "value": {
                "expr": "negativeColor"
              }
            },
            {
              "test": "datum.isSubtotal",
              "value": {
                "expr": "strongTextColor"
              }
            },
            {
              "test": "datum.column === 'Actual' || datum.column === 'YTD Actual'",
              "value": {
                "expr": "strongTextColor"
              }
            }
          ],
          "value": {
            "expr": "textColor"
          }
        }
      }
    },
    {
      "description": "invisible full-cell rects so every cell is hoverable, blanks included",
      "mark": {
        "type": "rect",
        "fill": {
          "expr": "bandColor"
        },
        "fillOpacity": 0
      },
      "encoding": {
        "x": {
          "field": "colIdx",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              14
            ],
            "nice": false,
            "zero": false,
            "clamp": false
          },
          "axis": null,
          "title": null
        },
        "x2": {
          "field": "colEnd"
        },
        "y": {
          "field": "rowIdx",
          "type": "quantitative",
          "scale": {
            "domain": [
              {
                "expr": "rowCount"
              },
              0
            ],
            "nice": false,
            "zero": false,
            "clamp": false
          },
          "axis": null,
          "title": null
        },
        "y2": {
          "field": "rowEnd"
        },
        "tooltip": [
          {
            "field": "Line",
            "type": "nominal",
            "title": "Line"
          },
          {
            "field": "column",
            "type": "nominal",
            "title": "Column"
          },
          {
            "field": "cell",
            "type": "nominal",
            "title": "Value"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Raw",
            "format": ",.4f"
          }
        ]
      }
    }
  ]
}
